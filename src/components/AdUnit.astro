---
interface Props {
  slot?: string;
  format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle';
  class?: string;
}

const { format = 'auto', class: className = '' } = Astro.props;
---

<div class:list={['ad-unit my-6 text-center', className]}>
  <ins class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-7638521765617220"
    data-ad-slot="1680217989"
    data-ad-format={format}
    data-full-width-responsive="true"></ins>
  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>
