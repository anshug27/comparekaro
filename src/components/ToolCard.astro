---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  color?: string;
}

const { title, description, href, icon, color = 'blue' } = Astro.props;

const glowMap: Record<string, string> = {
  blue: 'hover:shadow-blue-500/20 hover:border-blue-500/30',
  green: 'hover:shadow-emerald-500/20 hover:border-emerald-500/30',
  purple: 'hover:shadow-purple-500/20 hover:border-purple-500/30',
  orange: 'hover:shadow-orange-500/20 hover:border-orange-500/30',
  red: 'hover:shadow-rose-500/20 hover:border-rose-500/30',
  teal: 'hover:shadow-teal-500/20 hover:border-teal-500/30',
};

const iconBgMap: Record<string, string> = {
  blue: 'bg-blue-500/10 group-hover:bg-blue-500/20',
  green: 'bg-emerald-500/10 group-hover:bg-emerald-500/20',
  purple: 'bg-purple-500/10 group-hover:bg-purple-500/20',
  orange: 'bg-orange-500/10 group-hover:bg-orange-500/20',
  red: 'bg-rose-500/10 group-hover:bg-rose-500/20',
  teal: 'bg-teal-500/10 group-hover:bg-teal-500/20',
};

const arrowMap: Record<string, string> = {
  blue: 'text-blue-400',
  green: 'text-emerald-400',
  purple: 'text-purple-400',
  orange: 'text-orange-400',
  red: 'text-rose-400',
  teal: 'text-teal-400',
};

const glow = glowMap[color] || glowMap.blue;
const iconBg = iconBgMap[color] || iconBgMap.blue;
const arrow = arrowMap[color] || arrowMap.blue;
---

<a href={href} class={`group block relative bg-white/[0.03] rounded-2xl border border-white/[0.06] p-6 hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-400 card-3d overflow-hidden ${glow}`}>
  <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-white/[0.02] to-transparent rounded-bl-full pointer-events-none"></div>
  <div class:list={['w-14 h-14 rounded-xl flex items-center justify-center text-3xl mb-5 transition-all duration-300 group-hover:scale-110 group-hover:rotate-3', iconBg]}>
    {icon}
  </div>
  <h3 class="font-bold text-lg text-white mb-2 group-hover:text-white transition-colors">{title}</h3>
  <p class="text-gray-500 text-sm leading-relaxed mb-4">{description}</p>
  <div class={`flex items-center gap-1 text-sm font-medium ${arrow} opacity-0 group-hover:opacity-100 translate-x-0 group-hover:translate-x-1 transition-all duration-300`}>
    <span>Explore</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </div>
</a>
