---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  color?: string;
}

const { title, description, href, icon, color = 'blue' } = Astro.props;

const colorMap: Record<string, string> = {
  blue: 'bg-blue-50 text-blue-600 group-hover:bg-blue-100 ring-blue-600/10',
  green: 'bg-green-50 text-green-600 group-hover:bg-green-100 ring-green-600/10',
  purple: 'bg-purple-50 text-purple-600 group-hover:bg-purple-100 ring-purple-600/10',
  orange: 'bg-orange-50 text-orange-600 group-hover:bg-orange-100 ring-orange-600/10',
  red: 'bg-red-50 text-red-600 group-hover:bg-red-100 ring-red-600/10',
  teal: 'bg-teal-50 text-teal-600 group-hover:bg-teal-100 ring-teal-600/10',
};

const hoverBorderMap: Record<string, string> = {
  blue: 'hover:border-blue-300 hover:shadow-blue-600/5',
  green: 'hover:border-green-300 hover:shadow-green-600/5',
  purple: 'hover:border-purple-300 hover:shadow-purple-600/5',
  orange: 'hover:border-orange-300 hover:shadow-orange-600/5',
  red: 'hover:border-red-300 hover:shadow-red-600/5',
  teal: 'hover:border-teal-300 hover:shadow-teal-600/5',
};

const iconColor = colorMap[color] || colorMap.blue;
const borderColor = hoverBorderMap[color] || hoverBorderMap.blue;
---

<a href={href} class={`group block bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 ${borderColor}`}>
  <div class:list={['w-14 h-14 rounded-xl flex items-center justify-center text-3xl mb-5 transition-transform group-hover:scale-110 ring-1 ring-inset', iconColor]}>
    {icon}
  </div>
  <h3 class="font-bold text-xl text-gray-900 mb-2.5 transition-colors">{title}</h3>
  <p class="text-gray-500 text-sm leading-relaxed">{description}</p>
</a>
