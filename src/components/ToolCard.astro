---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  color?: string;
}

const { title, description, href, icon, color = 'blue' } = Astro.props;

const colorMap: Record<string, string> = {
  blue: 'bg-blue-50 text-blue-600 group-hover:bg-blue-100',
  green: 'bg-green-50 text-green-600 group-hover:bg-green-100',
  purple: 'bg-purple-50 text-purple-600 group-hover:bg-purple-100',
  orange: 'bg-orange-50 text-orange-600 group-hover:bg-orange-100',
  red: 'bg-red-50 text-red-600 group-hover:bg-red-100',
  teal: 'bg-teal-50 text-teal-600 group-hover:bg-teal-100',
};

const iconColor = colorMap[color] || colorMap.blue;
---

<a href={href} class="group block bg-white rounded-xl border border-gray-200 p-6 hover:shadow-lg hover:border-blue-200 transition-all duration-200">
  <div class:list={['w-12 h-12 rounded-lg flex items-center justify-center text-2xl mb-4 transition-colors', iconColor]}>
    {icon}
  </div>
  <h3 class="font-semibold text-lg text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">{title}</h3>
  <p class="text-gray-500 text-sm leading-relaxed">{description}</p>
</a>
