---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: object;
  ogImage?: string;
}

const {
  title,
  description = 'Compare mobile plans, calculate EMI, SIP returns & more. Free tools to help Indians make smarter financial decisions.',
  canonical,
  schema,
  ogImage,
} = Astro.props;

const siteUrl = 'https://comparekaro.download';
const fullTitle = title === 'CompareKaro' ? title + ' - Smart Comparison Tools for India' : title + ' | CompareKaro';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).href : new URL('/og/default.png', siteUrl).href;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CompareKaro" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a1a" />
    <meta name="author" content="CompareKaro" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="mitgo-verification" content="e9022a24-c2f6-41e1-aff6-ff69df4ec074" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="CompareKaro" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{fullTitle}</title>

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7GYM7LM778"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7GYM7LM778');
    </script>

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7638521765617220" crossorigin="anonymous"></script>
  </head>
  <body class="min-h-screen bg-[#0a0a1a] text-gray-100 flex flex-col font-sans">
    <!-- Header -->
    <header class="fixed top-0 w-full z-50 transition-all duration-300" id="site-header">
      <div class="absolute inset-0 bg-[#0a0a1a]/70 backdrop-blur-xl border-b border-white/5"></div>
      <nav class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-2.5 group">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-pink-500 rounded-lg blur-sm opacity-60 group-hover:opacity-100 transition-opacity"></div>
              <div class="relative bg-gradient-to-br from-indigo-500 to-pink-500 text-white p-1.5 rounded-lg">
                <svg class="w-5 h-5" viewBox="0 0 32 32" fill="none">
                  <path d="M8 16L14 22L24 10" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
            <span class="text-lg font-extrabold text-white">Compare<span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-pink-400">Karo</span></span>
          </a>

          <div class="hidden md:flex items-center gap-1">
            <a href="/tools" class="px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 rounded-lg font-medium transition-all">Tools</a>
            <a href="/compare" class="px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 rounded-lg font-medium transition-all">Phones</a>
            <a href="/tools/laptop-compare" class="px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 rounded-lg font-medium transition-all">Laptops</a>
            <a href="/tools/car-compare" class="px-4 py-2 text-sm text-gray-300 hover:text-white hover:bg-white/5 rounded-lg font-medium transition-all">Cars</a>
            <a href="/study" class="px-4 py-2 text-sm text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10 rounded-lg font-medium transition-all flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838l-3.14 1.346L9.606 11.92a1 1 0 00.788 0l7-3a1 1 0 000-1.84l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0z"/></svg>
              Study
            </a>
            <a href="/tools/plan-finder" class="ml-2 px-4 py-2 text-sm font-semibold bg-gradient-to-r from-indigo-500 to-pink-500 hover:from-indigo-400 hover:to-pink-400 text-white rounded-lg transition-all shadow-lg shadow-indigo-500/20">
              Find Plans
            </a>
          </div>

          <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-white/5 text-gray-300" aria-label="Menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>

        <div id="mobile-menu" class="hidden md:hidden pb-4 pt-2 space-y-1">
          <a href="/tools" class="block px-4 py-2.5 text-gray-300 hover:text-white hover:bg-white/5 rounded-lg font-medium transition-all">Tools</a>
          <a href="/compare" class="block px-4 py-2.5 text-gray-300 hover:text-white hover:bg-white/5 rounded-lg font-medium transition-all">Phones</a>
          <a href="/tools/laptop-compare" class="block px-4 py-2.5 text-gray-300 hover:text-white hover:bg-white/5 rounded-lg font-medium transition-all">Laptops</a>
          <a href="/tools/car-compare" class="block px-4 py-2.5 text-gray-300 hover:text-white hover:bg-white/5 rounded-lg font-medium transition-all">Cars</a>
          <a href="/study" class="block px-4 py-2.5 text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10 rounded-lg font-medium transition-all">Study (AI Tools)</a>
          <a href="/tools/plan-finder" class="block px-4 py-2.5 text-white bg-gradient-to-r from-indigo-500 to-pink-500 rounded-lg font-semibold mt-2">Find Plans</a>
        </div>
      </nav>
    </header>

    <!-- Spacer for fixed header -->
    <div class="h-16"></div>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="relative mt-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a1a] via-[#0d0d24] to-[#0a0a1a]"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-px bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent"></div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-8">
          <div class="md:col-span-1">
            <h3 class="text-white font-extrabold text-xl mb-4 flex items-center gap-2">
              <div class="bg-gradient-to-br from-indigo-500 to-pink-500 text-white p-1 rounded-md">
                <svg class="w-4 h-4" viewBox="0 0 32 32" fill="none">
                  <path d="M8 16L14 22L24 10" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              Compare<span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-pink-400">Karo</span>
            </h3>
            <p class="text-sm leading-relaxed text-gray-500">Free comparison tools to help Indians make smarter decisions about plans, finances, and purchases.</p>
            <div class="flex gap-3 mt-5">
              <a href="https://x.com/Deeptanshuhz5a" target="_blank" rel="noopener noreferrer me" aria-label="CompareKaro on X" class="w-9 h-9 rounded-lg bg-white/5 hover:bg-white/10 hover:text-white text-gray-500 flex items-center justify-center transition-all">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="https://www.linkedin.com/in/deeptanshu-goel/" target="_blank" rel="noopener noreferrer me" aria-label="Deeptanshu on LinkedIn" class="w-9 h-9 rounded-lg bg-white/5 hover:bg-[#0A66C2]/20 hover:text-[#0A66C2] text-gray-500 flex items-center justify-center transition-all">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
              </a>
            </div>
          </div>
          <div>
            <h4 class="text-white font-bold mb-5 tracking-wide text-xs uppercase">Financial Tools</h4>
            <ul class="space-y-3 text-sm text-gray-500">
              <li><a href="/tools/emi-calculator" class="hover:text-indigo-400 transition-colors">EMI Calculator</a></li>
              <li><a href="/tools/sip-calculator" class="hover:text-indigo-400 transition-colors">SIP Calculator</a></li>
              <li><a href="/tools/fd-calculator" class="hover:text-indigo-400 transition-colors">FD Calculator</a></li>
              <li><a href="/tools/salary-calculator" class="hover:text-indigo-400 transition-colors">Salary & Tax Calculator</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-bold mb-5 tracking-wide text-xs uppercase">Compare</h4>
            <ul class="space-y-3 text-sm text-gray-500">
              <li><a href="/tools/plan-finder" class="hover:text-indigo-400 transition-colors">Mobile Plan Finder</a></li>
              <li><a href="/compare" class="hover:text-indigo-400 transition-colors">Phone Comparison</a></li>
              <li><a href="/tools/laptop-compare" class="hover:text-indigo-400 transition-colors">Laptop Comparison</a></li>
              <li><a href="/tools/car-compare" class="hover:text-indigo-400 transition-colors">Car Comparison</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-bold mb-5 tracking-wide text-xs uppercase">More</h4>
            <ul class="space-y-3 text-sm text-gray-500">
              <li><a href="/study" class="hover:text-emerald-400 transition-colors">AI Study Tools</a></li>
              <li><a href="/about" class="hover:text-indigo-400 transition-colors">About Us</a></li>
              <li><a href="/privacy" class="hover:text-indigo-400 transition-colors">Privacy Policy</a></li>
              <li><a href="/contact" class="hover:text-indigo-400 transition-colors">Contact Us</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-white/5 mt-16 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-600">
          <p>&copy; {new Date().getFullYear()} CompareKaro - All rights reserved. Made in India</p>
          <div class="flex gap-4">
            <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
            <a href="/contact" class="hover:text-white transition-colors">Contact</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- PWA Install Banner -->
    <div id="pwa-install" class="fixed bottom-0 left-0 right-0 z-[60] translate-y-full transition-transform duration-500">
      <div class="max-w-lg mx-auto px-4 pb-4">
        <div class="bg-[#12122a] border border-indigo-500/30 rounded-2xl p-4 shadow-2xl shadow-black/50 backdrop-blur-xl">
          <div class="flex items-center gap-3">
            <img src="/icons/icon-192.png" alt="CompareKaro" class="w-12 h-12 rounded-xl" />
            <div class="flex-1 min-w-0">
              <p class="text-white font-bold text-sm">Add CompareKaro to Home Screen</p>
              <p class="text-gray-500 text-xs">Quick access to 40+ free tools</p>
            </div>
            <button id="pwa-close" class="text-gray-600 hover:text-white p-1 cursor-pointer" aria-label="Dismiss">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
          <button id="pwa-install-btn" class="mt-3 w-full px-4 py-2.5 bg-gradient-to-r from-indigo-500 to-pink-500 hover:from-indigo-400 hover:to-pink-400 text-white font-bold rounded-xl text-sm transition-all cursor-pointer shadow-lg shadow-indigo-500/20">
            Install App
          </button>
        </div>
      </div>
    </div>

    <script>
      // Mobile menu toggle
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

      // Scroll-triggered animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.fade-up, .stagger').forEach(el => observer.observe(el));

      // Header scroll effect
      let lastScroll = 0;
      const header = document.getElementById('site-header');
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        if (header) {
          if (y > 50) header.classList.add('shadow-lg', 'shadow-black/20');
          else header.classList.remove('shadow-lg', 'shadow-black/20');
        }
        lastScroll = y;
      }, { passive: true });
    </script>

    <!-- Service Worker + PWA Install Prompt -->
    <script is:inline>
      // Register service worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function() {});
        });
      }

      // PWA install prompt
      var deferredPrompt = null;
      var installBanner = document.getElementById('pwa-install');
      var installBtn = document.getElementById('pwa-install-btn');
      var closeBtn = document.getElementById('pwa-close');

      // Check if already dismissed recently (24 hours)
      var dismissed = localStorage.getItem('pwa-dismissed');
      var dismissTime = dismissed ? parseInt(dismissed) : 0;
      var showBanner = Date.now() - dismissTime > 86400000; // 24 hours

      // Check if already installed (standalone mode)
      var isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;

      // Android/Chrome: beforeinstallprompt fires when installable
      window.addEventListener('beforeinstallprompt', function(e) {
        e.preventDefault();
        deferredPrompt = e;
        if (showBanner && !isStandalone) {
          setTimeout(function() {
            installBanner.classList.remove('translate-y-full');
          }, 3000); // Show after 3 seconds
        }
      });

      // iOS Safari: no beforeinstallprompt, show manual instructions
      var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
      if (isIOS && !isStandalone && showBanner) {
        setTimeout(function() {
          installBtn.textContent = 'Tap Share ⬆ then "Add to Home Screen"';
          installBtn.addEventListener('click', function() {
            alert('To install CompareKaro:\n\n1. Tap the Share button (⬆) at the bottom of Safari\n2. Scroll down and tap "Add to Home Screen"\n3. Tap "Add"\n\nYou\'ll get a home screen icon for quick access!');
          });
          installBanner.classList.remove('translate-y-full');
        }, 3000);
      }

      // Install button click (Android/Chrome)
      if (installBtn) {
        installBtn.addEventListener('click', function() {
          if (deferredPrompt) {
            deferredPrompt.prompt();
            deferredPrompt.userChoice.then(function(choice) {
              if (choice.outcome === 'accepted') {
                installBanner.classList.add('translate-y-full');
              }
              deferredPrompt = null;
            });
          }
        });
      }

      // Close/dismiss
      if (closeBtn) {
        closeBtn.addEventListener('click', function() {
          installBanner.classList.add('translate-y-full');
          localStorage.setItem('pwa-dismissed', Date.now().toString());
        });
      }

      // Hide if installed
      window.addEventListener('appinstalled', function() {
        installBanner.classList.add('translate-y-full');
        deferredPrompt = null;
      });
    </script>
  </body>
</html>
