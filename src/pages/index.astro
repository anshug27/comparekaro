---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import AdUnit from '../components/AdUnit.astro';
import { phones } from '../data/phones';
import { laptops } from '../data/laptops';
import { cars } from '../data/cars';
import { plans } from '../data/plans';

const stats = [
  { value: phones.length, label: 'Phones' },
  { value: laptops.length, label: 'Laptops & Tablets' },
  { value: cars.length, label: 'Cars' },
  { value: plans.length, label: 'Recharge Plans' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CompareKaro',
  url: 'https://comparekaro.download',
  description: 'Free comparison tools for India - compare mobile plans, calculate EMI, SIP, and more.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://comparekaro.download/compare?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout title="CompareKaro" schema={schema}>
  <!-- Hero -->
  <section class="hero-bg relative overflow-hidden border-b border-gray-200/50">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-sm font-semibold mb-6 ring-1 ring-inset ring-blue-700/10">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
          </span>
          India's Fastest Comparison Tools
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold tracking-tight text-gray-900 mb-6 leading-tight">
          Compare Smarter.<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Save More.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed">
          Free tools to compare mobile plans, calculate EMI & SIP returns, and make better purchase decisions.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="/tools" class="inline-flex items-center justify-center px-8 py-3.5 bg-blue-600 text-white text-base font-semibold rounded-xl hover:bg-blue-700 transition-all shadow-md hover:shadow-xl hover:shadow-blue-600/20 w-full sm:w-auto">
            Explore All Tools
          </a>
          <a href="/tools/plan-finder" class="inline-flex items-center justify-center px-8 py-3.5 bg-white text-gray-900 border border-gray-200 text-base font-semibold rounded-xl hover:bg-gray-50 hover:border-gray-300 transition-all shadow-sm w-full sm:w-auto">
            Find Best Plan
          </a>
        </div>
      </div>

      <div class="mt-16 max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200/70 rounded-2xl overflow-hidden ring-1 ring-gray-200/70 shadow-sm">
        {stats.map(s => (
          <div class="bg-white/90 backdrop-blur px-6 py-5 text-center">
            <p class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">{s.value}+</p>
            <p class="text-sm font-medium text-gray-500 mt-1">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Popular Tools -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Popular Tools</h2>
      <p class="text-gray-500 max-w-2xl mx-auto text-lg">Free calculators and comparison tools used by thousands of Indians every day.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      <ToolCard
        title="EMI Calculator"
        description="Calculate monthly EMI for home, car, or personal loans. See total interest and amortization schedule."
        href="/tools/emi-calculator"
        icon="🏠"
        color="blue"
      />
      <ToolCard
        title="SIP Calculator"
        description="Estimate your mutual fund SIP returns with compound interest. Plan your wealth growth."
        href="/tools/sip-calculator"
        icon="📈"
        color="green"
      />
      <ToolCard
        title="FD Calculator"
        description="Calculate fixed deposit maturity amount with quarterly compounding for all major banks."
        href="/tools/fd-calculator"
        icon="🏦"
        color="purple"
      />
      <ToolCard
        title="Mobile Plan Finder"
        description="Find the best prepaid plan across Jio, Airtel, Vi & BSNL based on your data needs and budget."
        href="/tools/plan-finder"
        icon="📱"
        color="orange"
      />
      <ToolCard
        title="Rent vs Buy Calculator"
        description="Should you rent or buy a home? Compare total costs over 5-30 years with real numbers."
        href="/tools/rent-vs-buy"
        icon="🏡"
        color="teal"
      />
      <ToolCard
        title="Phone Comparison"
        description="Compare phones side-by-side on specs, price, camera, battery and performance."
        href="/compare"
        icon="🔍"
        color="red"
      />
    </div>
  </section>

  <AdUnit />

  <!-- How It Works -->
  <section class="bg-gray-50 py-20 border-y border-gray-200/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">Why CompareKaro?</h2>
        <p class="text-gray-500 text-lg">Built from the ground up to be fast, accurate, and completely free.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-2xl mb-6 ring-1 ring-inset ring-blue-600/10">
            ⚡
          </div>
          <h3 class="font-bold text-xl text-gray-900 mb-3">Instant Results</h3>
          <p class="text-gray-500 leading-relaxed">All calculations happen in your browser. No waiting, no sign-ups, no data collection.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-14 h-14 bg-green-50 text-green-600 rounded-xl flex items-center justify-center text-2xl mb-6 ring-1 ring-inset ring-green-600/10">
            🇮🇳
          </div>
          <h3 class="font-bold text-xl text-gray-900 mb-3">Built for India</h3>
          <p class="text-gray-500 leading-relaxed">Indian tax rules, Indian bank rates, Indian telecom plans. Everything localized for you.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-14 h-14 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-2xl mb-6 ring-1 ring-inset ring-purple-600/10">
            🔒
          </div>
          <h3 class="font-bold text-xl text-gray-900 mb-3">100% Free & Private</h3>
          <p class="text-gray-500 leading-relaxed">No registration needed. Your data stays on your device. We never store personal information.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Explore by Category</h2>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <a href="/tools#finance" class="group flex items-center gap-5 bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-xl hover:shadow-blue-600/5 hover:border-blue-300 transition-all duration-300">
        <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-xl group-hover:bg-blue-50 group-hover:scale-110 transition-all">
          <span class="text-2xl">💰</span>
        </div>
        <div>
          <h3 class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors">Finance</h3>
          <p class="text-sm text-gray-500 mt-0.5">EMI, SIP, FD, Tax</p>
        </div>
      </a>
      <a href="/tools#telecom" class="group flex items-center gap-5 bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-xl hover:shadow-indigo-600/5 hover:border-indigo-300 transition-all duration-300">
        <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-xl group-hover:bg-indigo-50 group-hover:scale-110 transition-all">
          <span class="text-2xl">📱</span>
        </div>
        <div>
          <h3 class="font-bold text-gray-900 group-hover:text-indigo-600 transition-colors">Telecom</h3>
          <p class="text-sm text-gray-500 mt-0.5">Plans, Recharge</p>
        </div>
      </a>
      <a href="/compare" class="group flex items-center gap-5 bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-xl hover:shadow-red-600/5 hover:border-red-300 transition-all duration-300">
        <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-xl group-hover:bg-red-50 group-hover:scale-110 transition-all">
          <span class="text-2xl">📊</span>
        </div>
        <div>
          <h3 class="font-bold text-gray-900 group-hover:text-red-600 transition-colors">Products</h3>
          <p class="text-sm text-gray-500 mt-0.5">Phones, Laptops</p>
        </div>
      </a>
      <a href="/tools#lifestyle" class="group flex items-center gap-5 bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-xl hover:shadow-teal-600/5 hover:border-teal-300 transition-all duration-300">
        <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-xl group-hover:bg-teal-50 group-hover:scale-110 transition-all">
          <span class="text-2xl">🏡</span>
        </div>
        <div>
          <h3 class="font-bold text-gray-900 group-hover:text-teal-600 transition-colors">Lifestyle</h3>
          <p class="text-sm text-gray-500 mt-0.5">Rent vs Buy, Salary</p>
        </div>
      </a>
    </div>
  </section>

  <AdUnit />
</Layout>
