import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us" description="CompareKaro.in helps Indians make smarter decisions with free comparison tools, financial calculators, and product comparisons.">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">About CompareKaro</h1>
    <div class="prose prose-gray max-w-none">
      <p>CompareKaro.in is a free platform that helps Indians make smarter decisions about money, technology, and everyday purchases.</p>
      <p>We believe everyone deserves access to clear, unbiased comparison tools — without having to sign up, pay, or hand over personal data.</p>

      <h2>What We Offer</h2>
      <ul>
        <li><strong>Financial Calculators:</strong> EMI, SIP, FD, and Rent vs Buy calculators tailored for Indian tax rules and bank rates.</li>
        <li><strong>Mobile Plan Finder:</strong> Compare prepaid recharge plans across Jio, Airtel, Vi, and BSNL to find the best value.</li>
        <li><strong>Product Comparison:</strong> Side-by-side spec comparisons for smartphones and gadgets available in India.</li>
      </ul>

      <h2>Our Principles</h2>
      <ul>
        <li><strong>Free forever:</strong> All tools are completely free with no hidden paywalls.</li>
        <li><strong>Privacy first:</strong> All calculations happen in your browser. We never store your financial data.</li>
        <li><strong>No bias:</strong> Our comparisons are based on specifications and numbers, not sponsorships.</li>
        <li><strong>Made for India:</strong> Everything is localized for Indian users — INR currency, Indian banks, Indian telecom operators.</li>
      </ul>

      <h2>How We Earn</h2>
      <p>CompareKaro is supported by advertisements displayed on our pages. We may also earn affiliate commissions when you click through to purchase a product. This never affects our rankings or recommendations.</p>

      <h2>Contact</h2>
      <p>Have feedback or suggestions? Reach us at <a href="/contact">our contact page</a>.</p>
    </div>
  </section>
</Layout>
