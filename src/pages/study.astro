---
import Layout from '../layouts/Layout.astro';
import AdUnit from '../components/AdUnit.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'AI Study Tools - StudyGenie',
  url: 'https://comparekaro.download/study',
  description: 'Free AI-powered study tools for students. Summarize notes, generate flashcards, create quizzes, solve math, and more.',
};

const studyGenieUrl = 'https://studygenie.pages.dev';

const tools = [
  {
    title: 'AI Text Summarizer',
    description: 'Paste any text and get an instant AI summary with key points, important terms, and difficulty level.',
    icon: '📝',
    href: `${studyGenieUrl}/tools/summarize`,
    color: 'from-indigo-500/20 to-blue-500/20',
    border: 'border-indigo-500/30',
    tag: 'Most Popular',
  },
  {
    title: 'AI Quiz Generator',
    description: 'Test yourself with AI-generated multiple choice questions from any study material. Instant quiz with explanations.',
    icon: '🧠',
    href: `${studyGenieUrl}/tools/quiz`,
    color: 'from-emerald-500/20 to-teal-500/20',
    border: 'border-emerald-500/30',
    tag: 'Exam Prep',
  },
  {
    title: 'AI Flashcard Maker',
    description: 'Turn any study material into interactive AI-generated flashcards. Paste notes and get flip-cards instantly.',
    icon: '🗂️',
    href: `${studyGenieUrl}/tools/flashcards`,
    color: 'from-pink-500/20 to-rose-500/20',
    border: 'border-pink-500/30',
    tag: 'Revision',
  },
  {
    title: 'AI Math Solver',
    description: 'Solve any math problem with step-by-step explanations. Algebra, calculus, geometry, statistics and more.',
    icon: '🔢',
    href: `${studyGenieUrl}/tools/math`,
    color: 'from-amber-500/20 to-orange-500/20',
    border: 'border-amber-500/30',
    tag: 'JEE / NEET',
  },
  {
    title: 'YouTube Video Summarizer',
    description: 'Get key takeaways, summaries, and timestamps from any YouTube video transcript.',
    icon: '▶️',
    href: `${studyGenieUrl}/tools/youtube`,
    color: 'from-red-500/20 to-rose-500/20',
    border: 'border-red-500/30',
    tag: 'Video Notes',
  },
  {
    title: 'AI Essay Grader',
    description: 'Get instant AI feedback on your essays. Scores for structure, grammar, vocabulary, and coherence.',
    icon: '📄',
    href: `${studyGenieUrl}/tools/essay`,
    color: 'from-purple-500/20 to-violet-500/20',
    border: 'border-purple-500/30',
    tag: 'Writing',
  },
  {
    title: 'Explain Like I\'m 5',
    description: 'Understand any complex topic in simple language with analogies, examples, and fun facts.',
    icon: '💡',
    href: `${studyGenieUrl}/tools/explain`,
    color: 'from-cyan-500/20 to-blue-500/20',
    border: 'border-cyan-500/30',
    tag: 'Learning',
  },
  {
    title: 'AI Notes Organizer',
    description: 'Transform messy notes into structured material. Supports Cornell Notes, Mind Map, and Outline format.',
    icon: '📋',
    href: `${studyGenieUrl}/tools/notes`,
    color: 'from-teal-500/20 to-emerald-500/20',
    border: 'border-teal-500/30',
    tag: 'Organize',
  },
  {
    title: 'AI Study Planner',
    description: 'Create a personalized study schedule for any exam. Weekly plans, daily routines, and revision strategies.',
    icon: '📅',
    href: `${studyGenieUrl}/tools/planner`,
    color: 'from-blue-500/20 to-indigo-500/20',
    border: 'border-blue-500/30',
    tag: 'Planning',
  },
];
---

<Layout
  title="AI Study Tools - Free Quiz, Flashcards, Summarizer, Math Solver"
  description="Free AI-powered study tools for students. Generate quizzes, flashcards, summaries, solve math problems, grade essays, and plan study schedules. Powered by StudyGenie."
  schema={schema}
  ogImage="/og/study.png"
>
  <!-- Hero -->
  <section class="hero-bg relative overflow-hidden">
    <div class="blob w-64 h-64 bg-indigo-600/20 top-10 left-[10%]" style="animation-delay: 0s;"></div>
    <div class="blob w-48 h-48 bg-emerald-500/15 top-32 right-[20%]" style="animation-delay: -3s;"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 text-center">
      <div class="fade-up inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-medium mb-6">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838l-3.14 1.346L9.606 11.92a1 1 0 00.788 0l7-3a1 1 0 000-1.84l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0z"/></svg>
        Powered by StudyGenie AI
      </div>

      <h1 class="fade-up text-4xl md:text-6xl font-extrabold tracking-tight mb-5 leading-[1.1]">
        <span class="text-white">AI Study Tools</span><br/>
        <span class="gradient-text">for Indian Students</span>
      </h1>

      <p class="fade-up text-lg text-gray-400 mb-8 max-w-2xl mx-auto leading-relaxed">
        Summarize notes, generate quizzes, create flashcards, solve math, and plan your study schedule. Free. No signup needed. Perfect for JEE, NEET, UPSC, and Board Exams.
      </p>

      <div class="fade-up flex flex-col sm:flex-row gap-3 justify-center">
        <a href={studyGenieUrl} target="_blank" rel="noopener" class="group relative inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold rounded-xl transition-all overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-r from-emerald-500 to-teal-500 transition-all group-hover:scale-105"></div>
          <span class="relative text-white flex items-center gap-2">
            Open StudyGenie
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </span>
        </a>
        <a href="#tools" class="inline-flex items-center justify-center px-8 py-3.5 bg-white/[0.06] hover:bg-white/[0.10] text-white border border-white/10 text-base font-semibold rounded-xl transition-all backdrop-blur-sm">
          Browse Tools Below
        </a>
      </div>

      <!-- Quick stats -->
      <div class="mt-14 flex flex-wrap justify-center gap-8 text-center">
        <div>
          <p class="text-2xl font-extrabold text-white">9</p>
          <p class="text-sm text-gray-500">AI Tools</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-white">Free</p>
          <p class="text-sm text-gray-500">5 uses/day</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-white">Gemini</p>
          <p class="text-sm text-gray-500">AI Powered</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-white">No Signup</p>
          <p class="text-sm text-gray-500">Just use it</p>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-[#0a0a1a] to-transparent"></div>
  </section>

  <!-- Tools Grid -->
  <section id="tools" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 scroll-mt-20">
    <div class="text-center mb-12 fade-up">
      <h2 class="text-3xl font-extrabold text-white mb-3">All AI Study Tools</h2>
      <p class="text-gray-500 text-lg">Click any tool to open it on StudyGenie. Works on phone, tablet, and desktop.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger">
      {tools.map(tool => (
        <a href={tool.href} target="_blank" rel="noopener" class={`group glass rounded-2xl p-6 hover:bg-white/[0.06] transition-all duration-300 border-l-2 ${tool.border}`}>
          <div class="flex items-start justify-between mb-3">
            <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${tool.color} flex items-center justify-center text-2xl group-hover:scale-110 transition-transform`}>
              {tool.icon}
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/[0.06] text-gray-500 font-medium">{tool.tag}</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-indigo-400 transition-colors">{tool.title}</h3>
          <p class="text-sm text-gray-500 leading-relaxed mb-3">{tool.description}</p>
          <span class="text-sm text-indigo-400 font-medium opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1">
            Open Tool
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <AdUnit />

  <!-- Use Cases -->
  <section class="relative py-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a1a] via-[#0d0d28] to-[#0a0a1a]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-emerald-500/5 rounded-full blur-[100px]"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 fade-up">
        <h2 class="text-3xl font-extrabold text-white mb-3">Perfect for Every Exam</h2>
        <p class="text-gray-500 text-lg">StudyGenie works with any subject, any exam, any content.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 stagger">
        {[
          { exam: 'JEE', desc: 'Physics, Chemistry, Math', emoji: '🎯' },
          { exam: 'NEET', desc: 'Biology, Chemistry, Physics', emoji: '🏥' },
          { exam: 'UPSC', desc: 'GS, CSAT, Optional', emoji: '🏛️' },
          { exam: 'Board Exams', desc: 'CBSE, ICSE, State', emoji: '📚' },
          { exam: 'CA / CS', desc: 'Accounts, Law, Tax', emoji: '📊' },
          { exam: 'GATE', desc: 'Engineering subjects', emoji: '⚙️' },
          { exam: 'CAT / MBA', desc: 'Quant, Verbal, DILR', emoji: '📈' },
          { exam: 'SSC / Bank', desc: 'Reasoning, GK, English', emoji: '🏦' },
          { exam: 'College', desc: 'Any semester, any subject', emoji: '🎓' },
          { exam: 'Self-Study', desc: 'Learn anything', emoji: '💡' },
        ].map(item => (
          <div class="glass rounded-xl p-4 text-center hover:bg-white/[0.06] transition-all">
            <span class="text-2xl block mb-2">{item.emoji}</span>
            <p class="text-white font-bold text-sm">{item.exam}</p>
            <p class="text-gray-600 text-xs mt-0.5">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12 fade-up">
      <h2 class="text-3xl font-extrabold text-white mb-3">How It Works</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger">
      <div class="glass rounded-2xl p-8 text-center">
        <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-indigo-500/10 flex items-center justify-center text-2xl">1️⃣</div>
        <h3 class="font-bold text-white text-lg mb-2">Paste Your Content</h3>
        <p class="text-gray-500 text-sm">Paste your notes, textbook paragraphs, lecture transcript, or YouTube video link.</p>
      </div>
      <div class="glass rounded-2xl p-8 text-center">
        <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-emerald-500/10 flex items-center justify-center text-2xl">2️⃣</div>
        <h3 class="font-bold text-white text-lg mb-2">AI Generates Material</h3>
        <p class="text-gray-500 text-sm">Google Gemini AI processes your content and creates quizzes, flashcards, summaries, or solves problems.</p>
      </div>
      <div class="glass rounded-2xl p-8 text-center">
        <div class="w-14 h-14 mx-auto mb-5 rounded-2xl bg-pink-500/10 flex items-center justify-center text-2xl">3️⃣</div>
        <h3 class="font-bold text-white text-lg mb-2">Study & Score</h3>
        <p class="text-gray-500 text-sm">Review the output, test yourself, and ace your exams. 5 free uses per day, no signup.</p>
      </div>
    </div>

    <div class="text-center mt-10">
      <a href={studyGenieUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-8 py-3.5 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-white font-bold rounded-xl shadow-lg shadow-emerald-500/20 transition-all">
        Start Studying Free
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>
  </section>

  <AdUnit />
</Layout>
