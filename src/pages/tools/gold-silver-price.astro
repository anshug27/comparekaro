---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Gold & Silver Price Calculator India',
  url: 'https://comparekaro.download/tools/gold-silver-price',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};

// Reference prices (updated periodically)
const gold24k = 14804; // per gram
const gold22k = 13570;
const gold18k = 11103;
const silver = 230; // per gram
const lastUpdated = '19 Oct 2026';
---

<Layout
  title="Gold & Silver Price India - Today's Rate, Calculator & Investment Comparison"
  description="Gold and silver prices in India today. Calculate jewelry cost with making charges, compare gold vs FD vs SIP returns, and check city-wise prices."
  schema={schema}
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/tools" class="hover:text-blue-600">Tools</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900">Gold & Silver Price</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Gold & Silver Price India</h1>
      <p class="text-gray-500 text-lg">Reference prices, jewelry calculator, and investment comparison.</p>
      <p class="text-xs text-gray-400 mt-1">Reference prices as of {lastUpdated}. Actual prices vary by city and jeweler.</p>
    </div>

    <!-- Current Prices -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-xl border border-yellow-200 p-5 text-center">
        <p class="text-xs text-yellow-700 font-medium">Gold 24K (1g)</p>
        <p class="text-2xl font-bold text-yellow-800 mt-1">₹{gold24k.toLocaleString('en-IN')}</p>
      </div>
      <div class="bg-gradient-to-br from-yellow-50 to-orange-50 rounded-xl border border-yellow-200 p-5 text-center">
        <p class="text-xs text-yellow-700 font-medium">Gold 22K (1g)</p>
        <p class="text-2xl font-bold text-yellow-800 mt-1">₹{gold22k.toLocaleString('en-IN')}</p>
      </div>
      <div class="bg-gradient-to-br from-yellow-50 to-amber-50 rounded-xl border border-yellow-200 p-5 text-center">
        <p class="text-xs text-yellow-700 font-medium">Gold 24K (10g)</p>
        <p class="text-2xl font-bold text-yellow-800 mt-1">₹{(gold24k * 10).toLocaleString('en-IN')}</p>
      </div>
      <div class="bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl border border-gray-200 p-5 text-center">
        <p class="text-xs text-gray-600 font-medium">Silver (1g)</p>
        <p class="text-2xl font-bold text-gray-700 mt-1">₹{silver}</p>
        <p class="text-xs text-gray-400 mt-0.5">₹{(silver * 1000).toLocaleString('en-IN')}/kg</p>
      </div>
    </div>

    <!-- Gold Jewelry Calculator -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Gold Jewelry Price Calculator</h2>
      <p class="text-sm text-gray-500 mb-5">Calculate the total cost of gold jewelry including making charges and GST.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Purity</label>
          <select id="jPurity" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm">
            <option value={gold24k}>24K (999)</option>
            <option value={gold22k} selected>22K (916) - Most Jewelry</option>
            <option value={gold18k}>18K (750)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Weight (grams)</label>
          <input type="number" id="jWeight" value="10" min="0.1" max="1000" step="0.1" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm" />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Making Charges (%)</label>
          <input type="number" id="jMaking" value="12" min="0" max="30" step="0.5" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm" />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">GST (%)</label>
          <input type="number" id="jGST" value="3" min="0" max="5" step="0.5" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm" />
        </div>
      </div>

      <button id="jCalcBtn" class="px-6 py-2.5 bg-yellow-600 text-white font-semibold rounded-lg hover:bg-yellow-700 text-sm">
        Calculate Jewelry Cost
      </button>

      <div id="jResults" class="mt-5 hidden">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="bg-yellow-50 rounded-lg p-3 text-center">
            <p class="text-xs text-gray-500">Gold Value</p>
            <p id="jGoldVal" class="text-lg font-bold text-yellow-700"></p>
          </div>
          <div class="bg-gray-50 rounded-lg p-3 text-center">
            <p class="text-xs text-gray-500">Making Charges</p>
            <p id="jMakingVal" class="text-lg font-bold text-gray-600"></p>
          </div>
          <div class="bg-gray-50 rounded-lg p-3 text-center">
            <p class="text-xs text-gray-500">GST</p>
            <p id="jGSTVal" class="text-lg font-bold text-gray-600"></p>
          </div>
          <div class="bg-yellow-100 rounded-lg p-3 text-center">
            <p class="text-xs text-gray-500">Total Cost</p>
            <p id="jTotal" class="text-lg font-bold text-yellow-800"></p>
          </div>
        </div>
      </div>
    </div>

    <AdUnit />

    <!-- Gold vs Other Investments -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Investment Comparison: Gold vs FD vs SIP</h2>
      <p class="text-sm text-gray-500 mb-5">Compare how ₹1 lakh invested in gold, FD, or mutual fund SIP would grow.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Investment Amount (₹)</label>
          <input type="number" id="invAmt" value="100000" min="1000" step="1000" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm" />
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Time Period (Years)</label>
          <input type="number" id="invYears" value="5" min="1" max="30" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm" />
        </div>
      </div>

      <button id="invBtn" class="px-6 py-2.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 text-sm">
        Compare Returns
      </button>

      <div id="invResults" class="mt-5 hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-gray-500 border-b border-gray-200">
                <th class="py-3 pr-4">Investment</th>
                <th class="py-3 px-4">Expected Return</th>
                <th class="py-3 px-4">Maturity Value</th>
                <th class="py-3 px-4">Profit</th>
                <th class="py-3 px-4">Tax Impact</th>
              </tr>
            </thead>
            <tbody id="invBody"></tbody>
          </table>
        </div>
        <p class="text-xs text-gray-400 mt-3">*Returns are indicative based on historical averages. Past performance doesn't guarantee future returns.</p>
      </div>
    </div>

    <!-- City-wise Prices -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Gold Price Across Major Cities</h2>
      <p class="text-xs text-gray-400 mb-4">Prices may vary ±₹50-200 per gram based on local demand and hallmarking.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-gray-500 border-b border-gray-200">
              <th class="py-2 pr-4">City</th>
              <th class="py-2 px-4">22K (1g)</th>
              <th class="py-2 px-4">24K (1g)</th>
              <th class="py-2 px-4">22K (10g)</th>
            </tr>
          </thead>
          <tbody id="cityPrices"></tbody>
        </table>
      </div>
    </div>

    <AdUnit />

    <div class="mt-8 bg-white rounded-xl border border-gray-200 p-6 md:p-8 prose prose-gray max-w-none">
      <h2>Gold Buying Guide India</h2>
      <ul>
        <li><strong>24K (999):</strong> Purest form, used for coins and bars. Too soft for jewelry.</li>
        <li><strong>22K (916):</strong> Most popular for Indian jewelry. Contains 91.6% gold.</li>
        <li><strong>18K (750):</strong> Used for diamond-studded jewelry. More durable, 75% gold.</li>
        <li><strong>Hallmark:</strong> Always buy BIS hallmarked gold (HUID number). Mandatory since 2023.</li>
        <li><strong>Making charges:</strong> Typically 8-25% depending on design complexity.</li>
        <li><strong>GST:</strong> 3% on gold value + making charges.</li>
        <li><strong>Digital Gold:</strong> Buy from apps (PhonePe, Paytm, Google Pay) — no making charges, 99.99% pure.</li>
      </ul>
      <p><em>Prices shown are reference rates. Check your local jeweler for exact pricing.</em></p>
    </div>
  </section>

  <script define:vars={{ gold24k, gold22k, gold18k, silver }}>
    const f = id => document.getElementById(id);
    const inr = n => '₹' + Math.round(n).toLocaleString('en-IN');

    // Jewelry calculator
    f('jCalcBtn').addEventListener('click', () => {
      const rate = +f('jPurity').value;
      const weight = +f('jWeight').value || 0;
      const making = +f('jMaking').value / 100;
      const gst = +f('jGST').value / 100;

      const goldVal = rate * weight;
      const makingVal = goldVal * making;
      const subtotal = goldVal + makingVal;
      const gstVal = subtotal * gst;
      const total = subtotal + gstVal;

      f('jGoldVal').textContent = inr(goldVal);
      f('jMakingVal').textContent = inr(makingVal);
      f('jGSTVal').textContent = inr(gstVal);
      f('jTotal').textContent = inr(total);
      f('jResults').classList.remove('hidden');
    });

    // Investment comparison
    f('invBtn').addEventListener('click', () => {
      const amt = +f('invAmt').value || 100000;
      const years = +f('invYears').value || 5;

      const investments = [
        { name: 'Physical Gold', rate: 10, tax: years > 3 ? 'LTCG 20% with indexation' : 'STCG as per slab', color: 'text-yellow-700' },
        { name: 'Gold ETF/SGB', rate: 10, tax: 'SGB: Tax-free on maturity', color: 'text-yellow-600' },
        { name: 'Fixed Deposit', rate: 7, tax: 'Interest taxed as per slab', color: 'text-blue-600' },
        { name: 'SIP (Equity MF)', rate: 13, tax: years > 1 ? 'LTCG 12.5% above ₹1.25L' : 'STCG 20%', color: 'text-green-600' },
        { name: 'PPF', rate: 7.1, tax: 'Fully tax-free (EEE)', color: 'text-purple-600' },
        { name: 'Silver', rate: 8, tax: years > 3 ? 'LTCG 20% with indexation' : 'STCG as per slab', color: 'text-gray-600' },
      ];

      f('invBody').innerHTML = investments.map(inv => {
        const maturity = amt * Math.pow(1 + inv.rate / 100, years);
        const profit = maturity - amt;
        return `<tr class="border-b border-gray-50">
          <td class="py-3 pr-4 font-medium ${inv.color}">${inv.name}</td>
          <td class="py-3 px-4">${inv.rate}% p.a.</td>
          <td class="py-3 px-4 font-bold">${inr(maturity)}</td>
          <td class="py-3 px-4 text-green-600">+${inr(profit)}</td>
          <td class="py-3 px-4 text-xs text-gray-500">${inv.tax}</td>
        </tr>`;
      }).join('');

      f('invResults').classList.remove('hidden');
    });

    // City-wise prices (±variation from base)
    const cities = [
      { name: 'Delhi', diff: 0 },
      { name: 'Mumbai', diff: 50 },
      { name: 'Chennai', diff: 100 },
      { name: 'Kolkata', diff: 30 },
      { name: 'Bangalore', diff: 60 },
      { name: 'Hyderabad', diff: 40 },
      { name: 'Ahmedabad', diff: 20 },
      { name: 'Pune', diff: 55 },
      { name: 'Jaipur', diff: 10 },
      { name: 'Lucknow', diff: 15 },
      { name: 'Kochi', diff: 120 },
      { name: 'Coimbatore', diff: 110 },
    ];

    f('cityPrices').innerHTML = cities.map(city => {
      const c22 = gold22k + city.diff;
      const c24 = gold24k + city.diff;
      return `<tr class="border-b border-gray-50 hover:bg-gray-50">
        <td class="py-2 pr-4 font-medium text-gray-900">${city.name}</td>
        <td class="py-2 px-4">${inr(c22)}</td>
        <td class="py-2 px-4">${inr(c24)}</td>
        <td class="py-2 px-4 font-bold text-yellow-700">${inr(c22 * 10)}</td>
      </tr>`;
    }).join('');

    // Auto-calculate
    f('jCalcBtn').click();
    f('invBtn').click();
  </script>
</Layout>
