---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Color Picker', url: 'https://comparekaro.download/tools/color-picker', applicationCategory: 'DesignApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' } };
---
<Layout title="Color Picker - HEX, RGB, HSL Converter & Palette Generator" description="Free color picker tool. Convert between HEX, RGB, and HSL. Generate color palettes, check contrast ratios, and copy color codes instantly." schema={schema}>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4"><a href="/" class="hover:text-indigo-400">Home</a><span class="mx-2">/</span><a href="/tools" class="hover:text-indigo-400">Tools</a><span class="mx-2">/</span><span class="text-white">Color Picker</span></nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Color Picker & Converter</h1>
      <p class="text-gray-400 text-lg">Pick a color, convert formats, generate palettes, check contrast.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      <!-- Picker -->
      <div class="glass rounded-2xl p-6">
        <div class="flex gap-4 items-start mb-5">
          <input type="color" id="picker" value="#6366f1" class="w-20 h-20 rounded-xl cursor-pointer bg-transparent border-0" />
          <div id="preview" class="flex-1 h-20 rounded-xl" style="background:#6366f1"></div>
        </div>

        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <label class="text-xs text-gray-500 w-10">HEX</label>
            <input type="text" id="hex" value="#6366f1" class="flex-1 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-sm text-gray-200 font-mono" />
            <button class="copy-btn px-3 py-2 bg-white/[0.06] rounded-lg text-xs text-gray-400 hover:text-white cursor-pointer" data-target="hex">Copy</button>
          </div>
          <div class="flex items-center gap-2">
            <label class="text-xs text-gray-500 w-10">RGB</label>
            <input type="text" id="rgb" value="rgb(99, 102, 241)" class="flex-1 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-sm text-gray-200 font-mono" />
            <button class="copy-btn px-3 py-2 bg-white/[0.06] rounded-lg text-xs text-gray-400 hover:text-white cursor-pointer" data-target="rgb">Copy</button>
          </div>
          <div class="flex items-center gap-2">
            <label class="text-xs text-gray-500 w-10">HSL</label>
            <input type="text" id="hsl" value="hsl(239, 84%, 67%)" class="flex-1 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-sm text-gray-200 font-mono" />
            <button class="copy-btn px-3 py-2 bg-white/[0.06] rounded-lg text-xs text-gray-400 hover:text-white cursor-pointer" data-target="hsl">Copy</button>
          </div>
        </div>

        <!-- RGB Sliders -->
        <div class="mt-5 space-y-2">
          <div class="flex items-center gap-2"><span class="text-xs text-red-400 w-6">R</span><input type="range" id="rSlider" min="0" max="255" value="99" class="flex-1 accent-red-500" /><span id="rVal" class="text-xs text-gray-400 w-8">99</span></div>
          <div class="flex items-center gap-2"><span class="text-xs text-green-400 w-6">G</span><input type="range" id="gSlider" min="0" max="255" value="102" class="flex-1 accent-green-500" /><span id="gVal" class="text-xs text-gray-400 w-8">102</span></div>
          <div class="flex items-center gap-2"><span class="text-xs text-blue-400 w-6">B</span><input type="range" id="bSlider" min="0" max="255" value="241" class="flex-1 accent-blue-500" /><span id="bVal" class="text-xs text-gray-400 w-8">241</span></div>
        </div>
      </div>

      <!-- Palette & Contrast -->
      <div class="space-y-6">
        <!-- Shades -->
        <div class="glass rounded-2xl p-6">
          <h3 class="font-bold text-white mb-3 text-sm">Shades & Tints</h3>
          <div id="shades" class="flex rounded-lg overflow-hidden h-12"></div>
        </div>

        <!-- Contrast Checker -->
        <div class="glass rounded-2xl p-6">
          <h3 class="font-bold text-white mb-3 text-sm">Contrast Checker</h3>
          <div class="grid grid-cols-2 gap-3 mb-3">
            <div id="contrastLight" class="p-4 rounded-lg text-center font-bold" style="background:#6366f1;color:#ffffff">
              White Text <span id="contrastLightRatio" class="block text-xs font-normal mt-1">-</span>
            </div>
            <div id="contrastDark" class="p-4 rounded-lg text-center font-bold" style="background:#6366f1;color:#000000">
              Black Text <span id="contrastDarkRatio" class="block text-xs font-normal mt-1">-</span>
            </div>
          </div>
        </div>

        <!-- Popular Colors -->
        <div class="glass rounded-2xl p-6">
          <h3 class="font-bold text-white mb-3 text-sm">Popular Colors</h3>
          <div class="flex flex-wrap gap-2">
            {['#ef4444','#f97316','#eab308','#22c55e','#06b6d4','#3b82f6','#6366f1','#8b5cf6','#ec4899','#f43f5e','#14b8a6','#84cc16','#000000','#ffffff','#64748b','#1e293b'].map(c => (
              <button class="preset-color w-8 h-8 rounded-lg border border-white/10 cursor-pointer hover:scale-110 transition-transform" style={`background:${c}`} data-color={c} title={c}></button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <AdUnit />
  </section>

  <script>
    const f = id => document.getElementById(id);

    function hexToRgb(hex) {
      const r = parseInt(hex.slice(1,3), 16), g = parseInt(hex.slice(3,5), 16), b = parseInt(hex.slice(5,7), 16);
      return { r, g, b };
    }
    function rgbToHex(r, g, b) { return '#' + [r,g,b].map(x => x.toString(16).padStart(2,'0')).join(''); }
    function rgbToHsl(r, g, b) {
      r /= 255; g /= 255; b /= 255;
      const max = Math.max(r,g,b), min = Math.min(r,g,b), l = (max+min)/2;
      let h = 0, s = 0;
      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        if (max === r) h = ((g - b) / d + (g < b ? 6 : 0)) / 6;
        else if (max === g) h = ((b - r) / d + 2) / 6;
        else h = ((r - g) / d + 4) / 6;
      }
      return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
    }
    function luminance(r, g, b) {
      const [rs, gs, bs] = [r,g,b].map(c => { c /= 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); });
      return 0.2126 * rs + 0.7152 * gs + 0.0722 * bs;
    }
    function contrast(l1, l2) { return ((Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05)).toFixed(2); }

    function update(hex) {
      const { r, g, b } = hexToRgb(hex);
      const hsl = rgbToHsl(r, g, b);

      f('picker').value = hex;
      f('preview').style.background = hex;
      f('hex').value = hex;
      f('rgb').value = `rgb(${r}, ${g}, ${b})`;
      f('hsl').value = `hsl(${hsl.h}, ${hsl.s}%, ${hsl.l}%)`;
      f('rSlider').value = r; f('rVal').textContent = r;
      f('gSlider').value = g; f('gVal').textContent = g;
      f('bSlider').value = b; f('bVal').textContent = b;

      // Shades
      const shades = f('shades');
      shades.innerHTML = '';
      for (let i = 0; i <= 9; i++) {
        const factor = i / 9;
        const sr = Math.round(r + (255 - r) * (1 - factor) * (i < 5 ? 0 : 1) - r * factor * (i < 5 ? 1 : 0) * (1 - i/5));
        const shade = i <= 4
          ? rgbToHex(Math.round(r + (255 - r) * (1 - i/4)), Math.round(g + (255 - g) * (1 - i/4)), Math.round(b + (255 - b) * (1 - i/4)))
          : rgbToHex(Math.round(r * (1 - (i-4)/5)), Math.round(g * (1 - (i-4)/5)), Math.round(b * (1 - (i-4)/5)));
        const div = document.createElement('div');
        div.className = 'flex-1 cursor-pointer hover:scale-y-110 transition-transform';
        div.style.background = shade;
        div.title = shade;
        div.addEventListener('click', () => update(shade));
        shades.appendChild(div);
      }

      // Contrast
      const lum = luminance(r, g, b);
      const wContrast = contrast(lum, 1);
      const bContrast = contrast(lum, 0);
      f('contrastLight').style.background = hex;
      f('contrastDark').style.background = hex;
      f('contrastLightRatio').textContent = `${wContrast}:1 ${parseFloat(wContrast) >= 4.5 ? 'AA Pass' : parseFloat(wContrast) >= 3 ? 'AA Large' : 'Fail'}`;
      f('contrastDarkRatio').textContent = `${bContrast}:1 ${parseFloat(bContrast) >= 4.5 ? 'AA Pass' : parseFloat(bContrast) >= 3 ? 'AA Large' : 'Fail'}`;
    }

    f('picker').addEventListener('input', e => update(e.target.value));
    f('hex').addEventListener('change', e => { if (/^#[0-9a-f]{6}$/i.test(e.target.value)) update(e.target.value); });
    ['rSlider','gSlider','bSlider'].forEach(id => {
      f(id).addEventListener('input', () => {
        update(rgbToHex(parseInt(f('rSlider').value), parseInt(f('gSlider').value), parseInt(f('bSlider').value)));
      });
    });
    document.querySelectorAll('.preset-color').forEach(btn => {
      btn.addEventListener('click', () => update(btn.dataset.color));
    });
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(f(btn.dataset.target).value);
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = 'Copy', 1500);
      });
    });

    update('#6366f1');
  </script>
</Layout>
