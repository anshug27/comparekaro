---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Password Generator',
  url: 'https://comparekaro.download/tools/password-generator',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};
---

<Layout
  title="Password Generator - Create Strong Passwords Instantly"
  description="Generate strong, random passwords instantly. Customize length, characters, symbols. Check password strength. Everything runs in your browser — nothing sent to servers."
  schema={schema}
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-indigo-400">Home</a>
        <span class="mx-2">/</span>
        <a href="/tools" class="hover:text-indigo-400">Tools</a>
        <span class="mx-2">/</span>
        <span class="text-white">Password Generator</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Password Generator</h1>
      <p class="text-gray-400 text-lg">Generate strong, unique passwords. Everything runs locally in your browser.</p>
    </div>

    <!-- Generator -->
    <div class="glass rounded-2xl p-6 md:p-8 mb-8">
      <!-- Password Display -->
      <div class="relative mb-6">
        <div id="password" class="w-full px-5 py-4 bg-white/[0.06] border border-white/10 rounded-xl text-xl md:text-2xl font-mono text-emerald-400 tracking-wider break-all min-h-[64px] pr-24 select-all">
          Click Generate
        </div>
        <div class="absolute right-2 top-1/2 -translate-y-1/2 flex gap-1">
          <button id="copyBtn" class="px-3 py-2 bg-white/[0.08] hover:bg-white/[0.15] rounded-lg text-xs font-medium text-gray-300 transition-all cursor-pointer" title="Copy">
            <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </button>
          <button id="refreshBtn" class="px-3 py-2 bg-white/[0.08] hover:bg-white/[0.15] rounded-lg text-xs font-medium text-gray-300 transition-all cursor-pointer" title="Regenerate">
            <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          </button>
        </div>
      </div>

      <!-- Strength Bar -->
      <div class="mb-6">
        <div class="flex justify-between text-xs mb-1">
          <span class="text-gray-500">Strength</span>
          <span id="strengthLabel" class="font-medium text-gray-400">-</span>
        </div>
        <div class="h-2 bg-white/[0.06] rounded-full overflow-hidden">
          <div id="strengthBar" class="h-full rounded-full transition-all duration-300" style="width:0%"></div>
        </div>
        <p id="crackTime" class="text-xs text-gray-600 mt-1">-</p>
      </div>

      <!-- Options -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-2">Length: <span id="lenDisplay" class="text-indigo-400">16</span></label>
          <input type="range" id="length" min="4" max="64" value="16" class="w-full accent-indigo-500" />
          <div class="flex justify-between text-[10px] text-gray-600 mt-1"><span>4</span><span>16</span><span>32</span><span>64</span></div>
        </div>
        <div class="space-y-3">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="upper" checked class="w-4 h-4 rounded accent-indigo-500" />
            <span class="text-sm text-gray-300">Uppercase (A-Z)</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="lower" checked class="w-4 h-4 rounded accent-indigo-500" />
            <span class="text-sm text-gray-300">Lowercase (a-z)</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="numbers" checked class="w-4 h-4 rounded accent-indigo-500" />
            <span class="text-sm text-gray-300">Numbers (0-9)</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="symbols" checked class="w-4 h-4 rounded accent-indigo-500" />
            <span class="text-sm text-gray-300">Symbols (!@#$%^&*)</span>
          </label>
        </div>
      </div>

      <button id="genBtn" class="w-full px-8 py-3 bg-gradient-to-r from-indigo-500 to-pink-500 hover:from-indigo-400 hover:to-pink-400 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/25 transition-all cursor-pointer text-lg">
        Generate Password
      </button>

      <!-- History -->
      <div id="historySection" class="hidden mt-6">
        <p class="text-xs text-gray-500 mb-2">Recent (this session only)</p>
        <div id="history" class="space-y-1.5 max-h-40 overflow-y-auto"></div>
      </div>
    </div>

    <AdUnit />

    <!-- Password Checker -->
    <div class="glass rounded-2xl p-6 mb-8">
      <h2 class="text-lg font-bold text-white mb-4">Check Your Password Strength</h2>
      <input type="text" id="checkInput" placeholder="Type or paste a password to check..." class="w-full px-4 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-lg text-gray-200 font-mono mb-3" />
      <div id="checkResult" class="hidden glass rounded-xl p-4">
        <div class="flex justify-between items-center mb-2">
          <span id="checkStrength" class="font-bold">-</span>
          <span id="checkTime" class="text-xs text-gray-500">-</span>
        </div>
        <div id="checkFeedback" class="text-sm text-gray-400 space-y-1"></div>
      </div>
    </div>

    <div class="glass rounded-2xl p-6">
      <h2 class="text-xl font-bold text-white mb-3">Password Security Tips</h2>
      <ul class="text-gray-400 text-sm space-y-2 list-disc list-inside">
        <li><strong class="text-gray-300">Use 16+ characters</strong> — each character exponentially increases the combinations an attacker must try.</li>
        <li><strong class="text-gray-300">Never reuse passwords</strong> — if one site is breached, all your accounts with the same password are compromised.</li>
        <li><strong class="text-gray-300">Use a password manager</strong> — Bitwarden (free), 1Password, or built-in browser password managers.</li>
        <li><strong class="text-gray-300">Enable 2FA</strong> — even a strong password can be phished. Use authenticator apps (not SMS) for important accounts.</li>
        <li><strong class="text-gray-300">Passphrases work too</strong> — "correct-horse-battery-staple" is strong and memorable.</li>
      </ul>
    </div>
  </section>

  <script>
    const f = id => document.getElementById(id);
    const charsets = {
      upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
      lower: 'abcdefghijklmnopqrstuvwxyz',
      numbers: '0123456789',
      symbols: '!@#$%^&*()_+-=[]{}|;:,.<>?',
    };
    const history = [];

    function generate() {
      const len = parseInt(f('length').value);
      let pool = '';
      if (f('upper').checked) pool += charsets.upper;
      if (f('lower').checked) pool += charsets.lower;
      if (f('numbers').checked) pool += charsets.numbers;
      if (f('symbols').checked) pool += charsets.symbols;
      if (!pool) { pool = charsets.lower; f('lower').checked = true; }

      const arr = new Uint32Array(len);
      crypto.getRandomValues(arr);
      let pw = '';
      for (let i = 0; i < len; i++) pw += pool[arr[i] % pool.length];

      f('password').textContent = pw;
      updateStrength(pw);

      history.unshift(pw);
      if (history.length > 5) history.pop();
      renderHistory();
      return pw;
    }

    function updateStrength(pw) {
      let score = 0;
      if (pw.length >= 8) score++;
      if (pw.length >= 12) score++;
      if (pw.length >= 16) score++;
      if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) score++;
      if (/\d/.test(pw)) score++;
      if (/[^a-zA-Z0-9]/.test(pw)) score++;
      if (pw.length >= 20) score++;

      const levels = [
        { label: 'Very Weak', color: 'bg-red-500', text: 'text-red-400', pct: 15 },
        { label: 'Weak', color: 'bg-orange-500', text: 'text-orange-400', pct: 30 },
        { label: 'Fair', color: 'bg-yellow-500', text: 'text-yellow-400', pct: 45 },
        { label: 'Good', color: 'bg-blue-500', text: 'text-blue-400', pct: 60 },
        { label: 'Strong', color: 'bg-emerald-500', text: 'text-emerald-400', pct: 75 },
        { label: 'Very Strong', color: 'bg-emerald-400', text: 'text-emerald-300', pct: 90 },
        { label: 'Excellent', color: 'bg-emerald-300', text: 'text-emerald-200', pct: 100 },
      ];
      const idx = Math.min(score, levels.length - 1);
      const level = levels[idx];
      f('strengthLabel').textContent = level.label;
      f('strengthLabel').className = `font-medium ${level.text}`;
      f('strengthBar').style.width = level.pct + '%';
      f('strengthBar').className = `h-full rounded-full transition-all duration-300 ${level.color}`;

      // Crack time estimate
      let poolSize = 0;
      if (/[a-z]/.test(pw)) poolSize += 26;
      if (/[A-Z]/.test(pw)) poolSize += 26;
      if (/\d/.test(pw)) poolSize += 10;
      if (/[^a-zA-Z0-9]/.test(pw)) poolSize += 32;
      const combinations = Math.pow(poolSize || 1, pw.length);
      const guessesPerSec = 1e10;
      const seconds = combinations / guessesPerSec / 2;
      let timeStr;
      if (seconds < 1) timeStr = 'Instantly';
      else if (seconds < 60) timeStr = Math.round(seconds) + ' seconds';
      else if (seconds < 3600) timeStr = Math.round(seconds / 60) + ' minutes';
      else if (seconds < 86400) timeStr = Math.round(seconds / 3600) + ' hours';
      else if (seconds < 86400 * 365) timeStr = Math.round(seconds / 86400) + ' days';
      else if (seconds < 86400 * 365 * 1000) timeStr = Math.round(seconds / (86400 * 365)) + ' years';
      else if (seconds < 86400 * 365 * 1e6) timeStr = Math.round(seconds / (86400 * 365 * 1000)) + 'K years';
      else timeStr = 'Millions+ years';
      f('crackTime').textContent = `Time to crack (10B guesses/sec): ${timeStr}`;
    }

    function renderHistory() {
      if (!history.length) return;
      f('historySection').classList.remove('hidden');
      f('history').innerHTML = history.map(pw =>
        `<div class="flex items-center justify-between p-2 bg-white/[0.03] rounded-lg">
          <code class="text-xs text-gray-400 font-mono truncate mr-2">${pw}</code>
          <button class="copy-hist text-[10px] px-2 py-1 bg-white/[0.06] rounded text-gray-500 hover:text-white cursor-pointer" data-pw="${pw}">Copy</button>
        </div>`
      ).join('');
      document.querySelectorAll('.copy-hist').forEach(btn => {
        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(btn.dataset.pw);
          btn.textContent = 'Copied!';
          setTimeout(() => btn.textContent = 'Copy', 1500);
        });
      });
    }

    f('length').addEventListener('input', e => { f('lenDisplay').textContent = e.target.value; });
    f('genBtn').addEventListener('click', generate);
    f('refreshBtn').addEventListener('click', generate);
    f('copyBtn').addEventListener('click', () => {
      const pw = f('password').textContent;
      if (pw && pw !== 'Click Generate') {
        navigator.clipboard.writeText(pw);
        f('copyBtn').innerHTML = '<span class="text-emerald-400">Copied!</span>';
        setTimeout(() => { f('copyBtn').innerHTML = '<svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>'; }, 1500);
      }
    });

    // Password checker
    f('checkInput').addEventListener('input', () => {
      const pw = f('checkInput').value;
      if (!pw) { f('checkResult').classList.add('hidden'); return; }
      f('checkResult').classList.remove('hidden');
      updateStrength(pw);
      f('checkStrength').textContent = f('strengthLabel').textContent;
      f('checkStrength').className = f('strengthLabel').className;
      f('checkTime').textContent = f('crackTime').textContent;

      const feedback = [];
      if (pw.length < 8) feedback.push('Too short — use at least 8 characters');
      if (pw.length < 12) feedback.push('Consider using 12+ characters');
      if (!/[A-Z]/.test(pw)) feedback.push('Add uppercase letters');
      if (!/[a-z]/.test(pw)) feedback.push('Add lowercase letters');
      if (!/\d/.test(pw)) feedback.push('Add numbers');
      if (!/[^a-zA-Z0-9]/.test(pw)) feedback.push('Add symbols for more security');
      if (/(.)\1{2,}/.test(pw)) feedback.push('Avoid repeated characters');
      if (/^(123|abc|password|qwerty)/i.test(pw)) feedback.push('Avoid common patterns');
      f('checkFeedback').innerHTML = feedback.length ? feedback.map(f => `<p class="text-xs">&#8226; ${f}</p>`).join('') : '<p class="text-xs text-emerald-400">Looks strong!</p>';
    });

    // Auto-generate on load
    generate();
  </script>
</Layout>
