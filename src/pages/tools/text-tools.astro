---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Text Tools', url: 'https://comparekaro.download/tools/text-tools', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' } };
---
<Layout title="Text Tools - Word Counter, Case Converter, Remove Duplicates" description="Free text tools: word counter, character counter, case converter, remove duplicates, sort lines, find & replace, and text repeater. Runs in your browser." schema={schema}>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4"><a href="/" class="hover:text-indigo-400">Home</a><span class="mx-2">/</span><a href="/tools" class="hover:text-indigo-400">Tools</a><span class="mx-2">/</span><span class="text-white">Text Tools</span></nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Text Tools</h1>
      <p class="text-gray-400 text-lg">Word counter, case converter, remove duplicates, and more.</p>
    </div>

    <div class="glass rounded-2xl p-6 md:p-8 mb-6">
      <textarea id="input" rows="8" placeholder="Paste or type your text here..." class="w-full px-4 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-sm text-gray-200 resize-y focus:ring-2 focus:ring-indigo-500 mb-4"></textarea>

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-5">
        <div class="glass rounded-lg p-3 text-center"><p class="text-xs text-gray-500">Characters</p><p id="chars" class="text-lg font-bold text-white">0</p></div>
        <div class="glass rounded-lg p-3 text-center"><p class="text-xs text-gray-500">Words</p><p id="words" class="text-lg font-bold text-indigo-400">0</p></div>
        <div class="glass rounded-lg p-3 text-center"><p class="text-xs text-gray-500">Sentences</p><p id="sentences" class="text-lg font-bold text-pink-400">0</p></div>
        <div class="glass rounded-lg p-3 text-center"><p class="text-xs text-gray-500">Lines</p><p id="lines" class="text-lg font-bold text-emerald-400">0</p></div>
        <div class="glass rounded-lg p-3 text-center"><p class="text-xs text-gray-500">Read Time</p><p id="readTime" class="text-lg font-bold text-amber-400">0s</p></div>
      </div>

      <!-- Actions -->
      <div class="flex flex-wrap gap-2">
        <button class="action px-4 py-2 rounded-lg bg-white/[0.06] text-gray-300 text-sm font-medium hover:bg-indigo-500/20 hover:text-indigo-400 transition-all cursor-pointer" data-action="upper">UPPERCASE</button>
        <button class="action px-4 py-2 rounded-lg bg-white/[0.06] text-gray-300 text-sm font-medium hover:bg-indigo-500/20 hover:text-indigo-400 transition-all cursor-pointer" data-action="lower">lowercase</button>
        <button class="action px-4 py-2 rounded-lg bg-white/[0.06] text-gray-300 text-sm font-medium hover:bg-indigo-500/20 hover:text-indigo-400 transition-all cursor-pointer" data-action="title">Title Case</button>
        <button class="action px-4 py-2 rounded-lg bg-white/[0.06] text-gray-300 text-sm font-medium hover:bg-indigo-500/20 hover:text-indigo-400 transition-all cursor-pointer" data-action="sentence">Sentence case</button>
        <button class="action px-4 py-2 rounded-lg bg-white/[0.06] text-gray-300 text-sm font-medium hover:bg-indigo-500/20 hover:text-indigo-400 transition-all cursor-pointer" data-action="reverse">Reverse</button>
        <button class="action px-4 py-2 rounded-lg bg-white/[0.06] text-gray-300 text-sm font-medium hover:bg-indigo-500/20 hover:text-indigo-400 transition-all cursor-pointer" data-action="sort">Sort Lines</button>
        <button class="action px-4 py-2 rounded-lg bg-white/[0.06] text-gray-300 text-sm font-medium hover:bg-indigo-500/20 hover:text-indigo-400 transition-all cursor-pointer" data-action="dedup">Remove Duplicates</button>
        <button class="action px-4 py-2 rounded-lg bg-white/[0.06] text-gray-300 text-sm font-medium hover:bg-indigo-500/20 hover:text-indigo-400 transition-all cursor-pointer" data-action="trim">Trim Spaces</button>
        <button class="action px-4 py-2 rounded-lg bg-white/[0.06] text-gray-300 text-sm font-medium hover:bg-indigo-500/20 hover:text-indigo-400 transition-all cursor-pointer" data-action="number">Number Lines</button>
        <button id="copyBtn" class="px-4 py-2 rounded-lg bg-emerald-500/20 text-emerald-400 text-sm font-medium hover:bg-emerald-500/30 transition-all cursor-pointer">Copy Result</button>
        <button id="clearBtn" class="px-4 py-2 rounded-lg bg-red-500/20 text-red-400 text-sm font-medium hover:bg-red-500/30 transition-all cursor-pointer">Clear</button>
      </div>
    </div>

    <!-- Find & Replace -->
    <div class="glass rounded-2xl p-6 mb-6">
      <h3 class="font-bold text-white mb-3">Find & Replace</h3>
      <div class="flex flex-wrap gap-3 items-end">
        <div class="flex-1 min-w-[120px]"><label class="block text-xs text-gray-500 mb-1">Find</label><input type="text" id="findText" placeholder="Find..." class="w-full px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-sm text-gray-200" /></div>
        <div class="flex-1 min-w-[120px]"><label class="block text-xs text-gray-500 mb-1">Replace with</label><input type="text" id="replaceText" placeholder="Replace..." class="w-full px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-sm text-gray-200" /></div>
        <button id="replaceBtn" class="px-5 py-2 rounded-lg bg-indigo-500/20 text-indigo-400 text-sm font-medium hover:bg-indigo-500/30 transition-all cursor-pointer">Replace All</button>
      </div>
    </div>

    <!-- Text Repeater -->
    <div class="glass rounded-2xl p-6 mb-8">
      <h3 class="font-bold text-white mb-3">Text Repeater</h3>
      <div class="flex flex-wrap gap-3 items-end">
        <div class="flex-1"><label class="block text-xs text-gray-500 mb-1">Text</label><input type="text" id="repeatText" placeholder="Enter text..." class="w-full px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-sm text-gray-200" /></div>
        <div class="w-24"><label class="block text-xs text-gray-500 mb-1">Times</label><input type="number" id="repeatCount" value="10" min="1" max="10000" class="w-full px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-sm text-gray-200 text-center" /></div>
        <button id="repeatBtn" class="px-5 py-2 rounded-lg bg-indigo-500/20 text-indigo-400 text-sm font-medium hover:bg-indigo-500/30 transition-all cursor-pointer">Repeat</button>
      </div>
      <div id="repeatResult" class="hidden mt-3 p-3 bg-white/[0.03] rounded-lg text-xs text-gray-400 max-h-32 overflow-y-auto break-all"></div>
    </div>

    <!-- AI Text Tools -->
    <div class="glass rounded-2xl p-6 mb-8 border border-purple-500/20">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-lg">🤖</span>
        <h2 class="text-lg font-bold text-white">AI Text Tools</h2>
        <span class="text-[10px] px-2 py-0.5 bg-purple-500/20 text-purple-400 rounded-full font-medium">Powered by Gemini</span>
      </div>
      <p class="text-gray-500 text-xs mb-3">Type or paste text above, then use these AI actions:</p>
      <div class="flex flex-wrap gap-2">
        <button class="ai-text-btn px-4 py-2 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-medium hover:bg-purple-500/20 transition-all cursor-pointer" data-action="rewrite">Rewrite Better</button>
        <button class="ai-text-btn px-4 py-2 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-medium hover:bg-purple-500/20 transition-all cursor-pointer" data-action="grammar">Fix Grammar</button>
        <button class="ai-text-btn px-4 py-2 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-medium hover:bg-purple-500/20 transition-all cursor-pointer" data-action="summarize">Summarize</button>
        <button class="ai-text-btn px-4 py-2 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-medium hover:bg-purple-500/20 transition-all cursor-pointer" data-action="formal">Make Formal</button>
        <button class="ai-text-btn px-4 py-2 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-medium hover:bg-purple-500/20 transition-all cursor-pointer" data-action="casual">Make Casual</button>
        <button class="ai-text-btn px-4 py-2 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-medium hover:bg-purple-500/20 transition-all cursor-pointer" data-action="hindi">Translate to Hindi</button>
        <button class="ai-text-btn px-4 py-2 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-medium hover:bg-purple-500/20 transition-all cursor-pointer" data-action="english">Translate to English</button>
        <button class="ai-text-btn px-4 py-2 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-medium hover:bg-purple-500/20 transition-all cursor-pointer" data-action="bullets">Convert to Bullet Points</button>
        <button class="ai-text-btn px-4 py-2 rounded-lg bg-purple-500/10 text-purple-400 text-sm font-medium hover:bg-purple-500/20 transition-all cursor-pointer" data-action="email">Write as Email</button>
      </div>
      <div id="aiTextLoading" class="hidden text-center py-4"><span class="text-gray-500 text-sm animate-pulse">AI is processing...</span></div>
      <div id="aiTextResult" class="hidden mt-4 glass rounded-xl p-4">
        <div class="flex justify-between items-center mb-2">
          <span class="text-xs text-gray-500">AI Result</span>
          <button id="aiCopyBtn" class="text-xs px-3 py-1 bg-white/[0.06] rounded text-gray-400 hover:text-white cursor-pointer">Copy</button>
        </div>
        <div id="aiTextOutput" class="text-sm text-gray-300 leading-relaxed whitespace-pre-wrap"></div>
      </div>
    </div>

    <AdUnit />
  </section>

  <script>
    const f = id => document.getElementById(id);
    const input = f('input');

    function updateStats() {
      const text = input.value;
      f('chars').textContent = text.length;
      f('words').textContent = text.trim() ? text.trim().split(/\s+/).length : 0;
      f('sentences').textContent = text.split(/[.!?]+/).filter(s => s.trim()).length;
      f('lines').textContent = text ? text.split('\n').length : 0;
      const wc = text.trim() ? text.trim().split(/\s+/).length : 0;
      const mins = Math.floor(wc / 200);
      const secs = Math.round((wc % 200) / 200 * 60);
      f('readTime').textContent = mins > 0 ? `${mins}m ${secs}s` : `${secs}s`;
    }
    input.addEventListener('input', updateStats);

    document.querySelectorAll('.action').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = input.value;
        switch(btn.dataset.action) {
          case 'upper': input.value = text.toUpperCase(); break;
          case 'lower': input.value = text.toLowerCase(); break;
          case 'title': input.value = text.replace(/\w\S*/g, t => t.charAt(0).toUpperCase() + t.substr(1).toLowerCase()); break;
          case 'sentence': input.value = text.replace(/(^\s*\w|[.!?]\s*\w)/g, c => c.toUpperCase()); break;
          case 'reverse': input.value = text.split('').reverse().join(''); break;
          case 'sort': input.value = text.split('\n').sort().join('\n'); break;
          case 'dedup': input.value = [...new Set(text.split('\n'))].join('\n'); break;
          case 'trim': input.value = text.split('\n').map(l => l.trim()).join('\n').replace(/\n{3,}/g, '\n\n'); break;
          case 'number': input.value = text.split('\n').map((l, i) => `${i + 1}. ${l}`).join('\n'); break;
        }
        updateStats();
      });
    });

    f('copyBtn').addEventListener('click', () => {
      navigator.clipboard.writeText(input.value);
      f('copyBtn').textContent = 'Copied!';
      setTimeout(() => f('copyBtn').textContent = 'Copy Result', 1500);
    });
    f('clearBtn').addEventListener('click', () => { input.value = ''; updateStats(); });
    f('replaceBtn').addEventListener('click', () => {
      const find = f('findText').value;
      if (find) { input.value = input.value.split(find).join(f('replaceText').value); updateStats(); }
    });
    f('repeatBtn').addEventListener('click', () => {
      const text = f('repeatText').value;
      const count = Math.min(parseInt(f('repeatCount').value) || 1, 10000);
      if (text) {
        const result = (text + '\n').repeat(count).trim();
        f('repeatResult').textContent = result;
        f('repeatResult').classList.remove('hidden');
        navigator.clipboard.writeText(result);
      }
    });

    // AI Text Tools
    const aiPrompts = {
      rewrite: t => `Rewrite the following text to be clearer and better written. Return only the rewritten text, nothing else:\n\n${t}`,
      grammar: t => `Fix all grammar, spelling, and punctuation errors in the following text. Return only the corrected text:\n\n${t}`,
      summarize: t => `Summarize the following text concisely in 2-4 sentences. Return only the summary:\n\n${t}`,
      formal: t => `Rewrite the following text in a formal, professional tone. Return only the rewritten text:\n\n${t}`,
      casual: t => `Rewrite the following text in a casual, friendly tone. Return only the rewritten text:\n\n${t}`,
      hindi: t => `Translate the following text to Hindi (Devanagari script). Return only the translation:\n\n${t}`,
      english: t => `Translate the following text to English. Return only the translation:\n\n${t}`,
      bullets: t => `Convert the following text into a bullet point list. Return only the bullet points:\n\n${t}`,
      email: t => `Write the following as a professional email with subject line, greeting, body, and sign-off. Return only the email:\n\n${t}`,
    };
    document.querySelectorAll('.ai-text-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const text = input.value.trim();
        if (!text) { alert('Please enter some text first'); return; }
        f('aiTextLoading').classList.remove('hidden');
        f('aiTextResult').classList.add('hidden');
        try {
          const res = await fetch('/api/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: aiPrompts[btn.dataset.action](text.slice(0, 10000)) }),
          });
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          f('aiTextOutput').textContent = data.text;
          f('aiTextResult').classList.remove('hidden');
        } catch (e) {
          f('aiTextOutput').textContent = 'Error: ' + e.message;
          f('aiTextResult').classList.remove('hidden');
        }
        f('aiTextLoading').classList.add('hidden');
      });
    });
    f('aiCopyBtn').addEventListener('click', () => {
      navigator.clipboard.writeText(f('aiTextOutput').textContent);
      f('aiCopyBtn').textContent = 'Copied!';
      setTimeout(() => f('aiCopyBtn').textContent = 'Copy', 1500);
    });
  </script>
</Layout>
