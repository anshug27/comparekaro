---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Electricity Bill Calculator India',
  url: 'https://comparekaro.download/tools/electricity-calculator',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};

// State-wise domestic tariff slabs (approximate, major states)
const states = [
  { name: 'Delhi (BSES)', slabs: [{upto:200,rate:3},{upto:400,rate:4.5},{upto:800,rate:6.5},{upto:1200,rate:7},{upto:Infinity,rate:8}], fixed: 40 },
  { name: 'Mumbai (Adani)', slabs: [{upto:100,rate:3.79},{upto:300,rate:5.93},{upto:500,rate:8.42},{upto:1000,rate:10.37},{upto:Infinity,rate:12.05}], fixed: 75 },
  { name: 'Bangalore (BESCOM)', slabs: [{upto:50,rate:4.15},{upto:100,rate:5.6},{upto:200,rate:7.15},{upto:500,rate:8.2},{upto:Infinity,rate:9.10}], fixed: 55 },
  { name: 'Chennai (TANGEDCO)', slabs: [{upto:100,rate:0},{upto:200,rate:2.5},{upto:500,rate:4.6},{upto:1000,rate:6.6},{upto:Infinity,rate:7.6}], fixed: 30 },
  { name: 'Hyderabad (TSSPDCL)', slabs: [{upto:50,rate:1.45},{upto:100,rate:2.6},{upto:200,rate:3.6},{upto:300,rate:5.5},{upto:500,rate:7.5},{upto:Infinity,rate:9.5}], fixed: 50 },
  { name: 'Kolkata (CESC)', slabs: [{upto:25,rate:4.39},{upto:60,rate:5.29},{upto:100,rate:6.19},{upto:150,rate:7.24},{upto:300,rate:8.89},{upto:Infinity,rate:10.59}], fixed: 50 },
  { name: 'Pune (MSEDCL)', slabs: [{upto:100,rate:4.41},{upto:300,rate:8.4},{upto:500,rate:10.72},{upto:Infinity,rate:12.62}], fixed: 100 },
  { name: 'Ahmedabad (UGVCL)', slabs: [{upto:50,rate:3.2},{upto:100,rate:3.5},{upto:200,rate:4.5},{upto:300,rate:5.5},{upto:500,rate:6.2},{upto:Infinity,rate:6.8}], fixed: 40 },
  { name: 'Jaipur (JVVNL)', slabs: [{upto:50,rate:4.75},{upto:150,rate:6.5},{upto:300,rate:7},{upto:500,rate:7.5},{upto:Infinity,rate:8}], fixed: 60 },
  { name: 'Lucknow (UPPCL)', slabs: [{upto:100,rate:3.5},{upto:150,rate:4},{upto:200,rate:4.5},{upto:300,rate:5.5},{upto:500,rate:6},{upto:Infinity,rate:7}], fixed: 55 },
  { name: 'Chandigarh', slabs: [{upto:150,rate:2.5},{upto:400,rate:4.5},{upto:800,rate:5.5},{upto:Infinity,rate:6.5}], fixed: 35 },
  { name: 'Bhopal (MPEB)', slabs: [{upto:50,rate:3.7},{upto:100,rate:5.3},{upto:200,rate:6.1},{upto:500,rate:6.6},{upto:Infinity,rate:7.4}], fixed: 60 },
];
---

<Layout
  title="Electricity Bill Calculator India - State-wise Tariffs & Solar Savings"
  description="Calculate your electricity bill for any Indian state. Compare tariffs, estimate solar panel savings. Delhi, Mumbai, Bangalore, Chennai, Hyderabad & more."
  schema={schema}
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-indigo-400">Home</a>
        <span class="mx-2">/</span>
        <a href="/tools" class="hover:text-indigo-400">Tools</a>
        <span class="mx-2">/</span>
        <span class="text-white">Electricity Bill Calculator</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Electricity Bill Calculator</h1>
      <p class="text-gray-500 text-lg">Calculate your monthly electricity bill and estimate solar savings.</p>
    </div>

    <!-- Calculator -->
    <div class="bg-white/[0.03] rounded-xl border border-white/10 p-6 mb-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-2">State / City</label>
          <select id="state" class="w-full px-4 py-3 border border-white/10 rounded-lg text-base">
            {states.map((s, i) => <option value={i}>{s.name}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-2">Monthly Units (kWh)</label>
          <input type="number" id="units" value="300" min="0" max="5000" step="10" class="w-full px-4 py-3 border border-white/10 rounded-lg text-lg" />
        </div>
      </div>

      <div class="mt-4">
        <label class="block text-sm font-medium text-gray-300 mb-2">Units: <span id="unitLabel" class="text-indigo-400 font-bold">300</span> kWh/month</label>
        <input type="range" id="unitSlider" min="0" max="2000" value="300" step="10" class="w-full h-2 bg-white/[0.08] rounded-lg appearance-none cursor-pointer accent-blue-600" />
        <div class="flex justify-between text-xs text-gray-400 mt-1">
          <span>0</span><span>500</span><span>1000</span><span>1500</span><span>2000</span>
        </div>
      </div>

      <button id="calcBtn" class="mt-6 px-8 py-3 bg-indigo-500 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">
        Calculate Bill
      </button>
    </div>

    <!-- Results -->
    <div id="results" class="hidden">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="bg-white/[0.03] rounded-xl border border-white/10 p-5 text-center">
          <p class="text-sm text-gray-500">Energy Charges</p>
          <p id="energyCharges" class="text-2xl font-bold text-indigo-400 mt-1"></p>
        </div>
        <div class="bg-white/[0.03] rounded-xl border border-white/10 p-5 text-center">
          <p class="text-sm text-gray-500">Fixed Charges</p>
          <p id="fixedCharges" class="text-2xl font-bold text-gray-300 mt-1"></p>
        </div>
        <div class="bg-gradient-to-r from-indigo-500/10 to-purple-500/10 rounded-xl border-2 border-indigo-500/20 p-5 text-center">
          <p class="text-sm text-gray-500">Total Monthly Bill</p>
          <p id="totalBill" class="text-2xl font-bold text-indigo-400 mt-1"></p>
        </div>
      </div>

      <!-- Slab Breakdown -->
      <div class="bg-white/[0.03] rounded-xl border border-white/10 p-6 mb-8">
        <h3 class="font-semibold text-gray-300 mb-4">Slab-wise Breakdown</h3>
        <div id="slabBreakdown" class="space-y-2"></div>
        <div class="mt-4 pt-3 border-t border-white/5 flex justify-between font-semibold text-sm">
          <span>Average Rate</span>
          <span id="avgRate" class="text-indigo-400"></span>
        </div>
      </div>

      <AdUnit />

      <!-- Solar Savings -->
      <div class="bg-gradient-to-r from-amber-500/10 to-orange-500/10 rounded-xl border border-amber-500/20 p-6 mb-8">
        <h3 class="text-lg font-bold text-yellow-700 mb-4">Solar Panel Savings Estimate</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div>
            <label class="block text-xs font-medium text-gray-400 mb-1">Rooftop Area (sq ft)</label>
            <input type="number" id="rooftop" value="200" min="50" max="2000" step="10" class="w-full px-3 py-2 border border-white/10 rounded-lg text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-400 mb-1">Avg Sunlight Hours/Day</label>
            <select id="sunlight" class="w-full px-3 py-2 border border-white/10 rounded-lg text-sm">
              <option value="4">4 hours (cloudy regions)</option>
              <option value="5" selected>5 hours (average)</option>
              <option value="6">6 hours (sunny regions)</option>
              <option value="7">7 hours (Rajasthan, Gujarat)</option>
            </select>
          </div>
        </div>
        <button id="solarBtn" class="px-6 py-2 bg-yellow-600 text-white font-semibold rounded-lg hover:bg-yellow-700 text-sm">
          Estimate Solar Savings
        </button>
        <div id="solarResults" class="hidden mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-white/[0.03] rounded-lg p-4 text-center">
            <p class="text-xs text-gray-500">System Size</p>
            <p id="solarKW" class="text-lg font-bold text-yellow-700"></p>
          </div>
          <div class="bg-white/[0.03] rounded-lg p-4 text-center">
            <p class="text-xs text-gray-500">Monthly Generation</p>
            <p id="solarUnits" class="text-lg font-bold text-emerald-400"></p>
          </div>
          <div class="bg-white/[0.03] rounded-lg p-4 text-center">
            <p class="text-xs text-gray-500">Annual Savings</p>
            <p id="solarSavings" class="text-lg font-bold text-emerald-400"></p>
          </div>
        </div>
        <div id="solarPayback" class="hidden mt-3 text-sm text-gray-400"></div>
      </div>

      <!-- Compare All States -->
      <div class="bg-white/[0.03] rounded-xl border border-white/10 p-6">
        <h3 class="font-semibold text-gray-300 mb-4">Compare Across States (for <span id="compareUnits">300</span> units)</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-gray-500 border-b border-white/10">
                <th class="py-2 pr-4">State</th>
                <th class="py-2 px-4">Energy</th>
                <th class="py-2 px-4">Fixed</th>
                <th class="py-2 px-4 font-bold">Total</th>
                <th class="py-2 px-4">Avg Rate</th>
              </tr>
            </thead>
            <tbody id="compareBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <AdUnit />

    <div class="mt-12 bg-white/[0.03] rounded-xl border border-white/10 p-6 md:p-8 prose prose-invert max-w-none">
      <h2>Understanding Your Electricity Bill</h2>
      <ul>
        <li><strong>Energy Charges:</strong> Slab-based — the more you consume, the higher the per-unit rate</li>
        <li><strong>Fixed Charges:</strong> Monthly meter charge, regardless of consumption</li>
        <li><strong>Fuel Surcharge:</strong> Not included (varies monthly, typically 5-15% extra)</li>
        <li><strong>Solar Savings:</strong> Estimated based on 1 kW per 100 sq ft rooftop, ₹50,000/kW installation cost</li>
      </ul>
      <p><em>Tariffs are approximate and may differ from actual bills. Check your DISCOM website for exact rates.</em></p>
    </div>
  </section>

  <script define:vars={{ states }}>
    const f = id => document.getElementById(id);
    const inr = n => '₹' + Math.round(n).toLocaleString('en-IN');

    function calcBill(stateIdx, units) {
      const state = states[stateIdx];
      let energy = 0, prev = 0;
      const breakdown = [];
      for (const slab of state.slabs) {
        if (units <= prev) break;
        const consumed = Math.min(units, slab.upto) - prev;
        const charge = consumed * slab.rate;
        energy += charge;
        if (consumed > 0) {
          breakdown.push({
            range: prev + ' – ' + (slab.upto === Infinity ? prev + '+' : slab.upto) + ' units',
            rate: slab.rate,
            units: consumed,
            charge,
          });
        }
        prev = slab.upto;
      }
      return { energy, fixed: state.fixed, total: energy + state.fixed, breakdown, avgRate: units > 0 ? energy / units : 0 };
    }

    // Sync slider and input
    f('unitSlider').addEventListener('input', () => {
      f('units').value = f('unitSlider').value;
      f('unitLabel').textContent = f('unitSlider').value;
    });
    f('units').addEventListener('input', () => {
      f('unitSlider').value = f('units').value;
      f('unitLabel').textContent = f('units').value;
    });

    f('calcBtn').addEventListener('click', () => {
      const stateIdx = +f('state').value;
      const units = +f('units').value || 0;
      const bill = calcBill(stateIdx, units);

      f('energyCharges').textContent = inr(bill.energy);
      f('fixedCharges').textContent = inr(bill.fixed);
      f('totalBill').textContent = inr(bill.total);
      f('avgRate').textContent = '₹' + bill.avgRate.toFixed(2) + '/unit';

      f('slabBreakdown').innerHTML = bill.breakdown.map(s => `
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">${s.range} @ ₹${s.rate}/unit</span>
          <span class="text-gray-300">${s.units} units = ${inr(s.charge)}</span>
        </div>
      `).join('');

      // Compare all states
      f('compareUnits').textContent = units;
      f('compareBody').innerHTML = states.map((s, i) => {
        const b = calcBill(i, units);
        return `<tr class="border-b border-white/5 ${i === stateIdx ? 'bg-indigo-500/10 font-semibold' : ''}">
          <td class="py-2 pr-4">${s.name}</td>
          <td class="py-2 px-4">${inr(b.energy)}</td>
          <td class="py-2 px-4">${inr(b.fixed)}</td>
          <td class="py-2 px-4 font-bold text-indigo-400">${inr(b.total)}</td>
          <td class="py-2 px-4">₹${b.avgRate.toFixed(2)}</td>
        </tr>`;
      }).join('');

      f('results').classList.remove('hidden');
    });

    // Solar calculator
    f('solarBtn').addEventListener('click', () => {
      const rooftop = +f('rooftop').value || 200;
      const sunlight = +f('sunlight').value || 5;
      const stateIdx = +f('state').value;
      const units = +f('units').value || 300;

      const kw = Math.min(rooftop / 100, 10); // ~1 kW per 100 sq ft, max 10kW
      const monthlyGen = Math.round(kw * sunlight * 30 * 0.8); // 80% efficiency
      const bill = calcBill(stateIdx, units);
      const billWithSolar = calcBill(stateIdx, Math.max(0, units - monthlyGen));
      const monthlySaving = bill.total - billWithSolar.total;
      const annualSaving = monthlySaving * 12;
      const installCost = kw * 50000; // ₹50k/kW avg with subsidy
      const paybackYears = annualSaving > 0 ? (installCost / annualSaving).toFixed(1) : 'N/A';

      f('solarKW').textContent = kw.toFixed(1) + ' kW';
      f('solarUnits').textContent = monthlyGen + ' kWh';
      f('solarSavings').textContent = inr(annualSaving) + '/yr';
      f('solarPayback').innerHTML = `
        <strong>Installation Cost:</strong> ~${inr(installCost)} (after subsidy) |
        <strong>Payback Period:</strong> ~${paybackYears} years |
        <strong>Monthly bill drops:</strong> ${inr(bill.total)} → ${inr(billWithSolar.total)}
      `;
      f('solarResults').classList.remove('hidden');
      f('solarPayback').classList.remove('hidden');
    });

    f('calcBtn').click();
  </script>
</Layout>
