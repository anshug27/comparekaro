---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Free Online Tools"
  description="Free calculators and comparison tools for India. EMI calculator, SIP calculator, FD calculator, mobile plan finder, rent vs buy calculator and more."
>
  <div class="page-header-bg bg-white/[0.03] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <span class="inline-block px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 text-xs font-semibold ring-1 ring-inset ring-blue-700/10 mb-4">100% Free</span>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4">Free Tools</h1>
      <p class="text-lg text-gray-500 max-w-2xl mb-8">All calculations run in your browser. No sign-ups, no data collection.</p>
      <div class="flex flex-wrap gap-2">
        {[['finance', '💰 Finance'], ['telecom', '📱 Telecom'], ['devices', '💻 Devices'], ['loans', '🏦 Loans'], ['lifestyle', '🏡 Lifestyle & Utilities']].map(([id, label]) => (
          <a href={`#${id}`} class="px-4 py-2 rounded-full bg-white/[0.03] border border-white/10 text-sm font-semibold text-gray-300 hover:border-blue-300 hover:text-indigo-400 hover:shadow-lg shadow-black/10 transition-all">{label}</a>
        ))}
      </div>
    </div>
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Finance -->
    <div id="finance" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">💰</span> Financial Calculators
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="EMI Calculator"
          description="Calculate monthly EMI for home, car, or personal loans. See total interest and amortization schedule."
          href="/tools/emi-calculator"
          icon="🏠"
          color="blue"
        />
        <ToolCard
          title="SIP Calculator"
          description="Estimate mutual fund SIP returns. See how your monthly investment grows with compound interest."
          href="/tools/sip-calculator"
          icon="📈"
          color="green"
        />
        <ToolCard
          title="FD Calculator"
          description="Calculate fixed deposit maturity amount with quarterly compounding for all major banks."
          href="/tools/fd-calculator"
          icon="🏦"
          color="purple"
        />
        <ToolCard
          title="Salary & Tax Calculator"
          description="Calculate take-home salary after income tax. Compare old vs new tax regime for FY 2025-26."
          href="/tools/salary-calculator"
          icon="💼"
          color="teal"
        />
        <ToolCard
          title="Gold & Silver Price"
          description="Gold and silver reference prices, jewelry cost calculator, and investment comparison tool."
          href="/tools/gold-silver-price"
          icon="🥇"
          color="orange"
        />
        <ToolCard
          title="Savings Goal Planner"
          description="Set a financial goal and find out how much to save monthly. Compare SIP, FD, and RD options."
          href="/tools/savings-goal"
          icon="🎯"
          color="green"
        />
      </div>
    </div>

    <AdUnit />

    <!-- Telecom & Subscriptions -->
    <div id="telecom" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">📱</span> Telecom & Subscriptions
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Mobile Plan Finder"
          description="Find the best prepaid plan across Jio, Airtel, Vi & BSNL based on your data needs and budget."
          href="/tools/plan-finder"
          icon="📱"
          color="orange"
        />
        <ToolCard
          title="Broadband Comparison"
          description="Compare fiber broadband plans from Jio Fiber, Airtel Xstream, ACT, BSNL & Tata Play."
          href="/tools/broadband-compare"
          icon="📡"
          color="blue"
        />
        <ToolCard
          title="Internet Speed Test"
          description="Test your internet download & upload speed. Get tips to improve your connection."
          href="/tools/speed-test"
          icon="🚀"
          color="purple"
        />
        <ToolCard
          title="OTT Comparison"
          description="Compare Netflix, JioHotstar, Amazon Prime, SonyLIV, ZEE5 & JioCinema plans and prices."
          href="/tools/ott-compare"
          icon="🎬"
          color="red"
        />
      </div>
    </div>

    <AdUnit />

    <!-- Compare Devices -->
    <div id="devices" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">💻</span> Compare Devices
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Laptop & Tablet Compare"
          description="Compare MacBook, Dell, HP, Lenovo laptops and iPad, Samsung tablets side by side."
          href="/tools/laptop-compare"
          icon="💻"
          color="purple"
        />
        <ToolCard
          title="Phone Comparison"
          description="Compare smartphones from Samsung, Apple, OnePlus, Xiaomi and more."
          href="/compare"
          icon="📱"
          color="green"
        />
      </div>
    </div>

    <!-- Loans & Cards -->
    <div id="loans" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">💳</span> Loans & Credit Cards
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Loan & Card Comparison"
          description="Compare home loans, personal loans & credit cards across SBI, HDFC, ICICI, Axis & more."
          href="/tools/loan-compare"
          icon="💳"
          color="orange"
        />
      </div>
    </div>

    <!-- Lifestyle & Utilities -->
    <div id="lifestyle" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">🏡</span> Lifestyle & Utilities
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Rent vs Buy Calculator"
          description="Should you rent or buy a home? Compare total costs over 5-30 years with real numbers."
          href="/tools/rent-vs-buy"
          icon="🏡"
          color="teal"
        />
        <ToolCard
          title="Electricity Bill Calculator"
          description="Calculate electricity bill for any Indian state. Compare tariffs and estimate solar panel savings."
          href="/tools/electricity-calculator"
          icon="⚡"
          color="blue"
        />
        <ToolCard
          title="Car Comparison"
          description="Compare 28+ cars from Maruti, Hyundai, Tata, Mahindra, Kia, Toyota. Specs, mileage, price."
          href="/tools/car-compare"
          icon="🚗"
          color="red"
        />
        <ToolCard
          title="Fuel Cost Calculator"
          description="Calculate trip fuel costs, monthly fuel budget, and compare city-wise petrol & diesel prices."
          href="/tools/fuel-calculator"
          icon="⛽"
          color="orange"
        />
        <ToolCard
          title="Age Calculator"
          description="Enter your birthday to get exact age, zodiac sign, life statistics and next birthday countdown."
          href="/tools/age-calculator"
          icon="🎂"
          color="purple"
        />
      </div>
    </div>

    <AdUnit />
  </section>
</Layout>
