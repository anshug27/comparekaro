---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<Layout
  title="Free Online Tools"
  description="Free calculators and comparison tools for India. EMI calculator, SIP calculator, FD calculator, mobile plan finder, rent vs buy calculator and more."
  ogImage="/og/tools.png"
>
  <!-- AI Assistant Banner -->
  <div class="bg-gradient-to-r from-purple-500/10 to-indigo-500/10 border-b border-purple-500/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <a href="/tools/ai-assistant" class="flex items-center gap-3 group">
        <span class="text-2xl">🤖</span>
        <div>
          <span class="text-white font-bold text-sm group-hover:text-purple-400 transition-colors">NEW: AI Assistant</span>
          <span class="text-gray-500 text-xs ml-2">Ask anything — writing, coding, math, translations. Powered by Gemini AI</span>
        </div>
        <span class="ml-auto text-purple-400 text-sm font-medium">Try Now →</span>
      </a>
    </div>
  </div>

  <div class="page-header-bg bg-white/[0.03] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <span class="inline-block px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 text-xs font-semibold ring-1 ring-inset ring-blue-700/10 mb-4">100% Free</span>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4">Free Tools</h1>
      <p class="text-lg text-gray-500 max-w-2xl mb-8">All calculations run in your browser. No sign-ups, no data collection.</p>
      <div class="flex flex-wrap gap-2">
        {[['ai', '🤖 AI Tools'], ['finance', '💰 Finance'], ['telecom', '📱 Telecom'], ['devices', '💻 Devices'], ['loans', '🏦 Loans'], ['lifestyle', '🏡 Lifestyle'], ['fun', '🎮 Fun & Social'], ['productivity', '📋 Productivity'], ['utilities', '🛠️ Utilities']].map(([id, label]) => (
          <a href={`#${id}`} class="px-4 py-2 rounded-full bg-white/[0.03] border border-white/10 text-sm font-semibold text-gray-300 hover:border-blue-300 hover:text-indigo-400 hover:shadow-lg shadow-black/10 transition-all">{label}</a>
        ))}
      </div>
    </div>
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- AI Tools -->
    <div id="ai" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">🤖</span> AI-Powered Tools
        <span class="text-xs px-2 py-1 bg-purple-500/20 text-purple-400 rounded-full font-medium">Gemini AI</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="AI Assistant"
          description="Ask anything — writing, coding, math, translations, business advice. Free AI chat powered by Gemini."
          href="/tools/ai-assistant"
          icon="🤖"
          color="purple"
        />
        <ToolCard
          title="AI Text Tools"
          description="Rewrite, fix grammar, translate, summarize, convert to email — all powered by AI."
          href="/tools/text-tools"
          icon="✍️"
          color="purple"
        />
        <ToolCard
          title="AI GST Lookup"
          description="Ask AI the GST rate for any product or service. Get HSN codes and explanations."
          href="/tools/gst-calculator"
          icon="🧾"
          color="blue"
        />
      </div>
    </div>

    <!-- Finance -->
    <div id="finance" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">💰</span> Financial Calculators
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="EMI Calculator"
          description="Calculate monthly EMI for home, car, or personal loans. See total interest and amortization schedule."
          href="/tools/emi-calculator"
          icon="🏠"
          color="blue"
        />
        <ToolCard
          title="SIP Calculator"
          description="Estimate mutual fund SIP returns. See how your monthly investment grows with compound interest."
          href="/tools/sip-calculator"
          icon="📈"
          color="green"
        />
        <ToolCard
          title="FD Calculator"
          description="Calculate fixed deposit maturity amount with quarterly compounding for all major banks."
          href="/tools/fd-calculator"
          icon="🏦"
          color="purple"
        />
        <ToolCard
          title="Salary & Tax Calculator"
          description="Calculate take-home salary after income tax. Compare old vs new tax regime for FY 2025-26."
          href="/tools/salary-calculator"
          icon="💼"
          color="teal"
        />
        <ToolCard
          title="Gold & Silver Price"
          description="Gold and silver reference prices, jewelry cost calculator, and investment comparison tool."
          href="/tools/gold-silver-price"
          icon="🥇"
          color="orange"
        />
        <ToolCard
          title="Savings Goal Planner"
          description="Set a financial goal and find out how much to save monthly. Compare SIP, FD, and RD options."
          href="/tools/savings-goal"
          icon="🎯"
          color="green"
        />
        <ToolCard
          title="GST Calculator"
          description="Add or remove GST at 5%, 12%, 18%, 28%. See CGST, SGST/IGST breakdown instantly."
          href="/tools/gst-calculator"
          icon="🧾"
          color="blue"
        />
        <ToolCard
          title="Currency Converter"
          description="Convert INR to USD, EUR, GBP, AED, SGD and 15+ currencies with reference rates."
          href="/tools/currency-converter"
          icon="💱"
          color="teal"
        />
        <ToolCard
          title="Percentage Calculator"
          description="Find % of a number, % change, marks percentage. All percentage calculations in one place."
          href="/tools/percentage-calculator"
          icon="📊"
          color="red"
        />
        <ToolCard
          title="Loan Eligibility"
          description="Check how much home, car, or personal loan you're eligible for based on your salary."
          href="/tools/loan-eligibility"
          icon="🏠"
          color="purple"
        />
        <ToolCard
          title="Invoice Generator"
          description="Create GST invoices instantly. Add items, apply GST rates, print or save as PDF."
          href="/tools/invoice-generator"
          icon="📄"
          color="orange"
        />
      </div>
    </div>

    <AdUnit />

    <!-- Telecom & Subscriptions -->
    <div id="telecom" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">📱</span> Telecom & Subscriptions
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Mobile Plan Finder"
          description="Find the best prepaid plan across Jio, Airtel, Vi & BSNL based on your data needs and budget."
          href="/tools/plan-finder"
          icon="📱"
          color="orange"
        />
        <ToolCard
          title="Broadband Comparison"
          description="Compare fiber broadband plans from Jio Fiber, Airtel Xstream, ACT, BSNL & Tata Play."
          href="/tools/broadband-compare"
          icon="📡"
          color="blue"
        />
        <ToolCard
          title="Internet Speed Test"
          description="Test your internet download & upload speed. Get tips to improve your connection."
          href="/tools/speed-test"
          icon="🚀"
          color="purple"
        />
        <ToolCard
          title="OTT Comparison"
          description="Compare Netflix, JioHotstar, Amazon Prime, SonyLIV, ZEE5 & JioCinema plans and prices."
          href="/tools/ott-compare"
          icon="🎬"
          color="red"
        />
      </div>
    </div>

    <AdUnit />

    <!-- Compare Devices -->
    <div id="devices" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">💻</span> Compare Devices
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Laptop & Tablet Compare"
          description="Compare MacBook, Dell, HP, Lenovo laptops and iPad, Samsung tablets side by side."
          href="/tools/laptop-compare"
          icon="💻"
          color="purple"
        />
        <ToolCard
          title="Phone Comparison"
          description="Compare smartphones from Samsung, Apple, OnePlus, Xiaomi and more."
          href="/compare"
          icon="📱"
          color="green"
        />
      </div>
    </div>

    <!-- Loans & Cards -->
    <div id="loans" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">💳</span> Loans & Credit Cards
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Loan & Card Comparison"
          description="Compare home loans, personal loans & credit cards across SBI, HDFC, ICICI, Axis & more."
          href="/tools/loan-compare"
          icon="💳"
          color="orange"
        />
      </div>
    </div>

    <!-- Lifestyle & Utilities -->
    <div id="lifestyle" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">🏡</span> Lifestyle & Utilities
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Rent vs Buy Calculator"
          description="Should you rent or buy a home? Compare total costs over 5-30 years with real numbers."
          href="/tools/rent-vs-buy"
          icon="🏡"
          color="teal"
        />
        <ToolCard
          title="Electricity Bill Calculator"
          description="Calculate electricity bill for any Indian state. Compare tariffs and estimate solar panel savings."
          href="/tools/electricity-calculator"
          icon="⚡"
          color="blue"
        />
        <ToolCard
          title="Car Comparison"
          description="Compare 28+ cars from Maruti, Hyundai, Tata, Mahindra, Kia, Toyota. Specs, mileage, price."
          href="/tools/car-compare"
          icon="🚗"
          color="red"
        />
        <ToolCard
          title="Fuel Cost Calculator"
          description="Calculate trip fuel costs, monthly fuel budget, and compare city-wise petrol & diesel prices."
          href="/tools/fuel-calculator"
          icon="⛽"
          color="orange"
        />
        <ToolCard
          title="Age Calculator"
          description="Enter your birthday to get exact age, zodiac sign, life statistics and next birthday countdown."
          href="/tools/age-calculator"
          icon="🎂"
          color="purple"
        />
        <ToolCard
          title="BMI Calculator"
          description="Check your body mass index, ideal weight, daily calorie needs. Uses Asian BMI standards."
          href="/tools/bmi-calculator"
          icon="🏋️"
          color="green"
        />
        <ToolCard
          title="Tip & Bill Splitter"
          description="Calculate tip amount and split the bill between friends. India tipping guide included."
          href="/tools/tip-calculator"
          icon="🧾"
          color="teal"
        />
        <ToolCard
          title="Recipe Cost Calculator"
          description="Calculate per-plate cost for any dish. Add ingredients or get AI recipe with costs."
          href="/tools/recipe-cost"
          icon="🍳"
          color="orange"
        />
        <ToolCard
          title="Baby Name Finder"
          description="AI-powered Indian baby names with meanings, origin, rashi. Hindu, Muslim, Sikh, Christian."
          href="/tools/baby-names"
          icon="👶"
          color="pink"
        />
      </div>
    </div>

    <AdUnit />

    <!-- Fun & Social -->
    <div id="fun" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">🎮</span> Fun & Social
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Love Calculator"
          description="Enter two names and check your compatibility! Get AI relationship advice. Just for fun!"
          href="/tools/love-calculator"
          icon="❤️"
          color="pink"
        />
        <ToolCard
          title="Daily Horoscope"
          description="AI-powered daily predictions for all 12 zodiac signs. Love, career, health, lucky numbers."
          href="/tools/horoscope"
          icon="🔮"
          color="purple"
        />
        <ToolCard
          title="Meme Generator"
          description="Upload image, add text, download meme. AI can suggest funny captions too!"
          href="/tools/meme-generator"
          icon="😂"
          color="orange"
        />
        <ToolCard
          title="Random Picker"
          description="Flip coins, roll dice, spin a wheel, random numbers, Yes/No, team generator."
          href="/tools/random-picker"
          icon="🎲"
          color="green"
        />
      </div>
    </div>

    <!-- Productivity -->
    <div id="productivity" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">📋</span> Productivity
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Resume Builder"
          description="Fill a form, get a clean professional resume. AI summary. Print or save as PDF."
          href="/tools/resume-builder"
          icon="📄"
          color="blue"
        />
        <ToolCard
          title="Pomodoro Timer"
          description="25/5 focus timer for studying and work. Session tracking, custom durations, auto-switching."
          href="/tools/pomodoro"
          icon="🍅"
          color="red"
        />
      </div>
    </div>

    <!-- Everyday Utilities -->
    <div id="utilities" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-extrabold text-white mb-6 flex items-center gap-3 scroll-mt-24">
        <span class="text-3xl">🛠️</span> Everyday Utilities
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard
          title="Unit Converter"
          description="Convert length, weight, temperature, area, speed, volume, and data storage units instantly."
          href="/tools/unit-converter"
          icon="📐"
          color="blue"
        />
        <ToolCard
          title="Discount Calculator"
          description="Calculate sale price after discount, compare two deals, find the discount percentage."
          href="/tools/discount-calculator"
          icon="🏷️"
          color="red"
        />
        <ToolCard
          title="Password Generator"
          description="Generate strong, random passwords. Check password strength. Everything runs locally."
          href="/tools/password-generator"
          icon="🔐"
          color="purple"
        />
        <ToolCard
          title="QR Code Generator"
          description="Create QR codes for URLs, text, WiFi, UPI payments, phone numbers. Download as PNG."
          href="/tools/qr-generator"
          icon="📱"
          color="green"
        />
        <ToolCard
          title="Text Tools"
          description="Word counter, character counter, case converter, sort lines, remove duplicates, find & replace."
          href="/tools/text-tools"
          icon="📝"
          color="blue"
        />
        <ToolCard
          title="Color Picker"
          description="Pick colors, convert HEX/RGB/HSL, generate shades, check contrast ratios for accessibility."
          href="/tools/color-picker"
          icon="🎨"
          color="red"
        />
        <ToolCard
          title="Stopwatch & Timer"
          description="Online stopwatch with lap times and countdown timer. Preset timers for quick use."
          href="/tools/stopwatch"
          icon="⏱️"
          color="orange"
        />
      </div>
    </div>
  </section>
</Layout>
