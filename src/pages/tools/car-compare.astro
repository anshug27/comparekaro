---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';
import { cars, carBrands } from '../../data/cars';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Car Comparison India',
  url: 'https://comparekaro.download/tools/car-compare',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};

const segmentLabels: Record<string, string> = {
  hatchback: 'Hatchback',
  sedan: 'Sedan',
  suv: 'SUV',
  'compact-suv': 'Compact SUV',
  mpv: 'MPV',
  ev: 'Electric',
};

const carsByBrand: Record<string, typeof cars> = {};
for (const c of cars) {
  if (!carsByBrand[c.brand]) carsByBrand[c.brand] = [];
  carsByBrand[c.brand].push(c);
}

function formatPrice(p: number) {
  return p >= 10000000 ? (p / 10000000).toFixed(2) + ' Cr' : (p / 100000).toFixed(2) + ' L';
}
---

<Layout
  title="Car Comparison India - Compare Maruti, Hyundai, Tata, Mahindra, Kia, Toyota"
  description="Compare 28+ cars side by side. Browse by brand, filter by segment. Maruti, Hyundai, Tata, Mahindra, Kia, Toyota, Honda, MG cars compared."
  schema={schema}
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-blue-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/tools" class="hover:text-blue-600">Tools</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900">Car Comparison</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Car Comparison India</h1>
      <p class="text-gray-500 text-lg">Browse by brand, compare specs, mileage, price and safety ratings.</p>
      <p class="text-xs text-gray-400 mt-1">Prices are ex-showroom and may vary by city.</p>
    </div>

    <!-- Compare Side by Side -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-10">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Compare Side by Side</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-5">
        <div class="space-y-3">
          <h3 class="font-semibold text-blue-600 text-sm">Car 1</h3>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Brand</label>
            <select id="cBrand1" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm">
              <option value="">All Brands</option>
              {carBrands.map(b => <option value={b}>{b}</option>)}
            </select>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Model</label>
            <select id="car1" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm">
              <option value="">Select Model</option>
              {cars.map(c => (
                <option value={c.id} data-brand={c.brand}>
                  {c.name} - ₹{formatPrice(c.priceMin)} ({segmentLabels[c.segment]})
                </option>
              ))}
            </select>
          </div>
        </div>
        <div class="space-y-3">
          <h3 class="font-semibold text-green-600 text-sm">Car 2</h3>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Brand</label>
            <select id="cBrand2" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm">
              <option value="">All Brands</option>
              {carBrands.map(b => <option value={b}>{b}</option>)}
            </select>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1">Model</label>
            <select id="car2" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm">
              <option value="">Select Model</option>
              {cars.map(c => (
                <option value={c.id} data-brand={c.brand}>
                  {c.name} - ₹{formatPrice(c.priceMin)} ({segmentLabels[c.segment]})
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>
      <button id="compareBtn" class="px-8 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">
        Compare Now
      </button>
      <div id="comparison" class="mt-6 bg-white rounded-xl border border-gray-200 overflow-hidden hidden"></div>
    </div>

    <AdUnit />

    <!-- Browse by Brand -->
    <div class="mt-10">
      <h2 class="text-2xl font-bold text-gray-900 mb-5">Browse Cars by Brand</h2>
      <div class="flex flex-wrap gap-2 mb-4">
        <button class="cbrand-tab px-4 py-2 rounded-full text-sm font-medium bg-blue-600 text-white" data-brand="all">All ({cars.length})</button>
        {Object.entries(carsByBrand).map(([brand, items]) => (
          <button class="cbrand-tab px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200" data-brand={brand}>
            {brand} ({items.length})
          </button>
        ))}
      </div>

      <!-- Segment filter -->
      <div class="flex flex-wrap gap-2 mb-6">
        <button class="cseg-tab px-3 py-1.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700" data-seg="all">All</button>
        {Object.entries(segmentLabels).map(([seg, label]) => (
          <button class="cseg-tab px-3 py-1.5 rounded-full text-xs font-medium bg-gray-50 text-gray-600 hover:bg-gray-100" data-seg={seg}>
            {label}
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="carGrid">
        {cars.sort((a, b) => a.priceMin - b.priceMin).map(c => (
          <div class="car-card bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md transition-shadow" data-brand={c.brand} data-seg={c.segment}>
            <div class="flex gap-4 items-start mb-2">
              <div class="shrink-0 w-16 h-16 rounded-xl bg-gray-100 flex items-center justify-center">
                {c.image
                  ? <img src={c.image} alt={c.name} class="w-full h-full object-contain rounded-xl" loading="lazy" />
                  : <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 17h.01M16 17h.01M3 11l1.5-5A2 2 0 016.4 4h11.2a2 2 0 011.9 1.5L21 11M3 11v5a1 1 0 001 1h1a2 2 0 002-2 2 2 0 012-2h6a2 2 0 012 2 2 2 0 002 2h1a1 1 0 001-1v-5M3 11h18"/></svg>
                }
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-[11px] uppercase tracking-wider text-blue-600 font-bold">{c.brand}</span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 font-medium">{segmentLabels[c.segment]}</span>
                </div>
                <h3 class="font-bold text-gray-900 mt-0.5">{c.name}</h3>
                <div>
                  <span class="text-blue-600 font-extrabold text-sm">&#8377;{formatPrice(c.priceMin)}</span>
                  <span class="text-[10px] text-gray-400 ml-1">onwards</span>
                </div>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1 mt-3 text-xs text-gray-500">
              <p><span class="text-gray-400">Engine:</span> {c.engine}</p>
              <p><span class="text-gray-400">Power:</span> {c.power}</p>
              <p><span class="text-gray-400">Mileage:</span> {c.mileage}</p>
              <p><span class="text-gray-400">Fuel:</span> {c.fuelType}</p>
              <p><span class="text-gray-400">Safety:</span> {c.safetyRating}</p>
              <p><span class="text-gray-400">Seats:</span> {c.seating}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <AdUnit />

    <div class="mt-12 bg-white rounded-xl border border-gray-200 p-6 md:p-8 prose prose-gray max-w-none">
      <h2>How to Choose the Right Car</h2>
      <ul>
        <li><strong>Budget under ₹8L:</strong> Maruti Swift, Tata Punch, Hyundai i20 — reliable hatchbacks</li>
        <li><strong>₹8-12L (Compact SUV):</strong> Tata Nexon, Maruti Brezza, Hyundai Venue — 5-star safety</li>
        <li><strong>₹12-20L (Mid SUV):</strong> Hyundai Creta, Kia Seltos, Mahindra XUV 3XO — feature loaded</li>
        <li><strong>₹14-27L (Full SUV):</strong> Mahindra XUV700, Scorpio N, Tata Harrier — powerful engines, 7 seats</li>
        <li><strong>Family MPV:</strong> Toyota Innova Hycross, Kia Carens — best-in-class ride quality</li>
        <li><strong>Electric:</strong> Tata Nexon EV, MG ZS EV — zero emissions, low running cost</li>
      </ul>
      <p><em>Ex-showroom prices may vary by city. On-road price includes RTO, insurance, and accessories.</em></p>
    </div>
  </section>

  <script define:vars={{ cars }}>
    function filterModels(brandSel, modelSel) {
      const brand = brandSel.value;
      modelSel.querySelectorAll('option[data-brand]').forEach(opt => {
        opt.style.display = (!brand || opt.dataset.brand === brand) ? '' : 'none';
      });
    }

    document.getElementById('cBrand1').addEventListener('change', function() {
      filterModels(this, document.getElementById('car1'));
      document.getElementById('car1').value = '';
    });
    document.getElementById('cBrand2').addEventListener('change', function() {
      filterModels(this, document.getElementById('car2'));
      document.getElementById('car2').value = '';
    });

    // Brand tabs
    let activeBrand = 'all', activeSeg = 'all';
    function applyFilters() {
      document.querySelectorAll('.car-card').forEach(card => {
        const bm = activeBrand === 'all' || card.dataset.brand === activeBrand;
        const sm = activeSeg === 'all' || card.dataset.seg === activeSeg;
        card.style.display = (bm && sm) ? '' : 'none';
      });
    }

    document.querySelectorAll('.cbrand-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.cbrand-tab').forEach(t => { t.classList.remove('bg-blue-600','text-white'); t.classList.add('bg-gray-100','text-gray-700'); });
        tab.classList.add('bg-blue-600','text-white'); tab.classList.remove('bg-gray-100','text-gray-700');
        activeBrand = tab.dataset.brand;
        applyFilters();
      });
    });

    document.querySelectorAll('.cseg-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.cseg-tab').forEach(t => { t.classList.remove('bg-blue-100','text-blue-700'); t.classList.add('bg-gray-50','text-gray-600'); });
        tab.classList.add('bg-blue-100','text-blue-700'); tab.classList.remove('bg-gray-50','text-gray-600');
        activeSeg = tab.dataset.seg;
        applyFilters();
      });
    });

    // Comparison
    const formatPrice = p => p >= 10000000 ? '₹' + (p / 10000000).toFixed(2) + ' Cr' : '₹' + (p / 100000).toFixed(2) + ' L';

    const specs = [
      { key: 'priceMin', label: 'Starting Price', format: v => formatPrice(v), compare: 'lower' },
      { key: 'priceMax', label: 'Top Variant', format: v => formatPrice(v) },
      { key: 'segment', label: 'Segment', format: v => v.charAt(0).toUpperCase() + v.slice(1).replace('-', ' ') },
      { key: 'engine', label: 'Engine', format: v => v },
      { key: 'power', label: 'Power', format: v => v },
      { key: 'mileage', label: 'Mileage', format: v => v },
      { key: 'transmission', label: 'Transmission', format: v => v },
      { key: 'fuelType', label: 'Fuel Type', format: v => v },
      { key: 'seating', label: 'Seating', format: v => v + ' seats', compare: 'higher' },
      { key: 'safetyRating', label: 'Safety Rating', format: v => v },
      { key: 'bootSpace', label: 'Boot Space', format: v => v },
      { key: 'groundClearance', label: 'Ground Clearance', format: v => v },
      { key: 'rating', label: 'Rating', format: v => v + ' / 5', compare: 'higher' },
    ];

    document.getElementById('compareBtn').addEventListener('click', () => {
      const c1 = cars.find(c => c.id === document.getElementById('car1').value);
      const c2 = cars.find(c => c.id === document.getElementById('car2').value);
      if (!c1 || !c2) { alert('Please select both cars'); return; }

      const container = document.getElementById('comparison');
      container.classList.remove('hidden');

      let html = `
        <div class="grid grid-cols-3 bg-gray-50 border-b border-gray-200">
          <div class="p-4 font-semibold text-gray-600 text-sm">Specification</div>
          <div class="p-4 text-center font-bold text-blue-700">${c1.name}</div>
          <div class="p-4 text-center font-bold text-green-700">${c2.name}</div>
        </div>
      `;

      specs.forEach(spec => {
        const v1 = c1[spec.key], v2 = c2[spec.key];
        let cl1 = '', cl2 = '';
        if (spec.compare && typeof v1 === 'number' && typeof v2 === 'number') {
          if (spec.compare === 'lower') { if (v1 < v2) cl1 = 'text-green-600 font-semibold'; else if (v2 < v1) cl2 = 'text-green-600 font-semibold'; }
          else { if (v1 > v2) cl1 = 'text-green-600 font-semibold'; else if (v2 > v1) cl2 = 'text-green-600 font-semibold'; }
        }
        html += `<div class="grid grid-cols-3 border-b border-gray-100 hover:bg-gray-50">
          <div class="p-4 text-sm font-medium text-gray-600">${spec.label}</div>
          <div class="p-4 text-sm text-center ${cl1}">${spec.format(v1)}</div>
          <div class="p-4 text-sm text-center ${cl2}">${spec.format(v2)}</div>
        </div>`;
      });

      container.innerHTML = html;
      container.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>
</Layout>
