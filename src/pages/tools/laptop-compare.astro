---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';
import { laptops, laptopBrands, categories } from '../../data/laptops';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Laptop & Tablet Comparison India',
  url: 'https://comparekaro.download/tools/laptop-compare',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};

const laptopList = laptops.filter(l => l.type === 'Laptop');
const tabletList = laptops.filter(l => l.type === 'Tablet');

// Group by brand
const laptopsByBrand: Record<string, typeof laptops> = {};
for (const l of laptopList) {
  if (!laptopsByBrand[l.brand]) laptopsByBrand[l.brand] = [];
  laptopsByBrand[l.brand].push(l);
}

const categoryLabels: Record<string, string> = {
  budget: 'Budget',
  midrange: 'Mid-Range',
  premium: 'Premium',
  gaming: 'Gaming',
  ultrabook: 'Ultrabook',
  tablet: 'Tablet',
};
---

<Layout
  title="Laptop & Tablet Comparison India - MacBook vs Dell vs HP vs Lenovo vs ASUS"
  description="Compare 30+ laptops and tablets side by side. Browse by brand, get configuration suggestions based on budget and use-case. MacBook, Dell, HP, Lenovo, ASUS, Acer, MSI."
  schema={schema}
  ogImage="/og/laptops.png"
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-indigo-400">Home</a>
        <span class="mx-2">/</span>
        <a href="/tools" class="hover:text-indigo-400">Tools</a>
        <span class="mx-2">/</span>
        <span class="text-white">Laptop & Tablet Comparison</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Laptop & Tablet Comparison</h1>
      <p class="text-gray-500 text-lg">Browse by brand, compare side by side, or get a recommendation based on your budget and needs.</p>
    </div>

    <!-- Configuration Suggester -->
    <div class="bg-gradient-to-r from-indigo-500/10 to-purple-500/10 rounded-xl border border-indigo-500/20 p-6 mb-10">
      <h2 class="text-xl font-bold text-white mb-4">Find Your Perfect Laptop</h2>
      <p class="text-sm text-gray-500 mb-5">Tell us your budget and use-case, and we'll recommend the best options.</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5">
        <div>
          <label class="block text-xs font-medium text-gray-400 mb-1">Budget (₹)</label>
          <select id="sugBudget" class="w-full px-3 py-2.5 border border-white/10 rounded-lg text-sm">
            <option value="40000">Under ₹40,000</option>
            <option value="60000">Under ₹60,000</option>
            <option value="80000" selected>Under ₹80,000</option>
            <option value="100000">Under ₹1,00,000</option>
            <option value="150000">Under ₹1,50,000</option>
            <option value="999999">No limit</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-400 mb-1">Use Case</label>
          <select id="sugUse" class="w-full px-3 py-2.5 border border-white/10 rounded-lg text-sm">
            <option value="student">Student / Basic Use</option>
            <option value="office">Office / Productivity</option>
            <option value="coding">Coding / Development</option>
            <option value="creative">Video Editing / Creative</option>
            <option value="gaming">Gaming</option>
            <option value="portable">Ultraportable / Travel</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-400 mb-1">Preferred OS</label>
          <select id="sugOS" class="w-full px-3 py-2.5 border border-white/10 rounded-lg text-sm">
            <option value="any">Any</option>
            <option value="windows">Windows</option>
            <option value="macos">macOS</option>
          </select>
        </div>
      </div>

      <button id="suggestBtn" class="px-6 py-2.5 bg-indigo-500 text-white font-semibold rounded-lg hover:bg-blue-700 text-sm transition-colors">
        Get Recommendations
      </button>

      <div id="sugResults" class="mt-5 hidden">
        <h3 class="font-semibold text-white mb-3">Recommended for you:</h3>
        <div id="sugCards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>
    </div>

    <AdUnit />

    <!-- Compare Side by Side -->
    <div class="mt-10 mb-10">
      <h2 class="text-2xl font-bold text-white mb-5">Compare Side by Side</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
        <!-- Device 1 -->
        <div class="bg-white/[0.03] rounded-xl border border-white/10 p-5">
          <h3 class="font-semibold text-indigo-400 mb-3">Device 1</h3>
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Brand</label>
              <select id="lBrand1" class="w-full px-3 py-2.5 border border-white/10 rounded-lg text-sm">
                <option value="">All Brands</option>
                {laptopBrands.map(b => <option value={b}>{b}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Model</label>
              <select id="device1" class="w-full px-3 py-2.5 border border-white/10 rounded-lg text-sm">
                <option value="">Select Model</option>
                {laptops.map(l => (
                  <option value={l.id} data-brand={l.brand}>
                    {l.name} - &#8377;{l.price.toLocaleString('en-IN')} ({l.type})
                  </option>
                ))}
              </select>
            </div>
          </div>
        </div>
        <!-- Device 2 -->
        <div class="bg-white/[0.03] rounded-xl border border-white/10 p-5">
          <h3 class="font-semibold text-emerald-400 mb-3">Device 2</h3>
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Brand</label>
              <select id="lBrand2" class="w-full px-3 py-2.5 border border-white/10 rounded-lg text-sm">
                <option value="">All Brands</option>
                {laptopBrands.map(b => <option value={b}>{b}</option>)}
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Model</label>
              <select id="device2" class="w-full px-3 py-2.5 border border-white/10 rounded-lg text-sm">
                <option value="">Select Model</option>
                {laptops.map(l => (
                  <option value={l.id} data-brand={l.brand}>
                    {l.name} - &#8377;{l.price.toLocaleString('en-IN')} ({l.type})
                  </option>
                ))}
              </select>
            </div>
          </div>
        </div>
      </div>

      <button id="compareBtn" class="px-8 py-3 bg-indigo-500 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">
        Compare Now
      </button>

      <div id="comparison" class="mt-6 bg-white/[0.03] rounded-xl border border-white/10 overflow-hidden hidden"></div>
    </div>

    <AdUnit />

    <!-- Browse by Brand -->
    <div class="mt-10">
      <h2 class="text-2xl font-bold text-white mb-5">Browse Laptops by Brand</h2>
      <div class="flex flex-wrap gap-2 mb-6">
        <button class="lbrand-tab px-4 py-2 rounded-full text-sm font-medium bg-indigo-500 text-white" data-brand="all">All ({laptopList.length})</button>
        {Object.entries(laptopsByBrand).map(([brand, items]) => (
          <button class="lbrand-tab px-4 py-2 rounded-full text-sm font-medium bg-white/[0.06] text-gray-300 hover:bg-white/[0.08]" data-brand={brand}>
            {brand} ({items.length})
          </button>
        ))}
      </div>

      <!-- Category filter -->
      <div class="flex flex-wrap gap-2 mb-6">
        <button class="lcat-tab px-3 py-1.5 rounded-full text-xs font-medium bg-indigo-500/20 text-indigo-400" data-cat="all">All</button>
        {['budget', 'midrange', 'ultrabook', 'gaming', 'premium'].map(cat => (
          <button class="lcat-tab px-3 py-1.5 rounded-full text-xs font-medium bg-white/[0.02] text-gray-400 hover:bg-white/[0.08]" data-cat={cat}>
            {categoryLabels[cat]}
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="laptopGrid">
        {laptopList.sort((a, b) => a.price - b.price).map(l => (
          <div class="laptop-card bg-white/[0.03] rounded-xl border border-white/10 p-5 hover:shadow-md transition-shadow" data-brand={l.brand} data-cat={l.category}>
            <div class="flex gap-4 items-start mb-2">
              <div class="shrink-0 w-16 h-16 rounded-xl bg-white/[0.06] flex items-center justify-center">
                {l.image
                  ? <img src={l.image} alt={l.name} class="w-full h-full object-contain rounded-xl" loading="lazy" />
                  : <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                }
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-[11px] uppercase tracking-wider text-indigo-400 font-bold">{l.brand}</span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/[0.06] text-gray-500 font-medium">{categoryLabels[l.category]}</span>
                </div>
                <h3 class="font-bold text-white mt-0.5">{l.name}</h3>
                <span class="text-indigo-400 font-extrabold text-sm">&#8377;{l.price.toLocaleString('en-IN')}</span>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1 mt-3 text-xs text-gray-500">
              <p><span class="text-gray-400">CPU:</span> {l.processor}</p>
              <p><span class="text-gray-400">RAM:</span> {l.ram}</p>
              <p><span class="text-gray-400">GPU:</span> {l.gpu}</p>
              <p><span class="text-gray-400">Storage:</span> {l.storage}</p>
              <p><span class="text-gray-400">Display:</span> {l.displaySize}</p>
              <p><span class="text-gray-400">Battery:</span> {l.battery}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/5">
              <a href={`https://www.amazon.in/s?k=${encodeURIComponent(l.name)}&tag=comparekaro03-21`} target="_blank" rel="nofollow sponsored" class="block w-full text-center bg-yellow-400 hover:bg-amber-500/100 text-black text-sm font-semibold px-4 py-2 rounded-lg transition-colors">
                Check Price on Amazon
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tablets -->
    <div class="mt-12">
      <h2 class="text-2xl font-bold text-white mb-5">Tablets</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tabletList.sort((a, b) => a.price - b.price).map(l => (
          <div class="bg-white/[0.03] rounded-xl border border-white/10 p-5 hover:shadow-md transition-shadow">
            <div class="flex gap-4 items-start mb-2">
              <div class="shrink-0 w-16 h-16 rounded-xl bg-white/[0.06] flex items-center justify-center">
                {l.image
                  ? <img src={l.image} alt={l.name} class="w-full h-full object-contain rounded-xl" loading="lazy" />
                  : <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                }
              </div>
              <div class="flex-1 min-w-0">
                <span class="text-[11px] uppercase tracking-wider text-indigo-400 font-bold">{l.brand}</span>
                <h3 class="font-bold text-white mt-0.5">{l.name}</h3>
                <span class="text-indigo-400 font-extrabold text-sm">&#8377;{l.price.toLocaleString('en-IN')}</span>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1 mt-3 text-xs text-gray-500">
              <p><span class="text-gray-400">CPU:</span> {l.processor}</p>
              <p><span class="text-gray-400">RAM:</span> {l.ram}</p>
              <p><span class="text-gray-400">Display:</span> {l.displaySize}</p>
              <p><span class="text-gray-400">Battery:</span> {l.battery}</p>
              <p><span class="text-gray-400">Storage:</span> {l.storage}</p>
              <p><span class="text-gray-400">Weight:</span> {l.weight}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/5">
              <a href={`https://www.amazon.in/s?k=${encodeURIComponent(l.name)}&tag=comparekaro03-21`} target="_blank" rel="nofollow sponsored" class="block w-full text-center bg-yellow-400 hover:bg-amber-500/100 text-black text-sm font-semibold px-4 py-2 rounded-lg transition-colors">
                Check Price on Amazon
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <AdUnit />

    <div class="mt-12 bg-white/[0.03] rounded-xl border border-white/10 p-6 md:p-8 prose prose-invert max-w-none">
      <h2>How to Choose the Right Laptop or Tablet</h2>
      <p>Use the "Find Your Perfect Laptop" tool above to get personalized recommendations, or browse by brand and category.</p>
      <ul>
        <li><strong>Students (under ₹50K):</strong> Lenovo IdeaPad 3, ASUS Vivobook 15, Acer Aspire Go — reliable, good battery</li>
        <li><strong>Office/Coding (₹50K-80K):</strong> Lenovo IdeaPad Slim 5, ThinkPad E14, HP Pavilion 15 — solid performance</li>
        <li><strong>Ultraportable:</strong> MacBook Air M3, ASUS Zenbook 14, Acer Swift Go 14 — under 1.3kg, OLED displays</li>
        <li><strong>Gaming (₹80K-1.2L):</strong> ASUS TUF A15, Acer Nitro V, HP Victus — RTX 4050, 144Hz</li>
        <li><strong>Gaming (₹1.2L+):</strong> HP OMEN 16, ASUS ROG Strix G16, Dell G15 — RTX 4060/4070</li>
        <li><strong>Premium:</strong> MacBook Pro M3 Pro/Max, Dell XPS 14 — best displays, top performance</li>
        <li><strong>Budget Tablet:</strong> Xiaomi Pad 7, iPad 10th Gen — great value under ₹40K</li>
        <li><strong>Pro Tablet:</strong> iPad Pro M4, Samsung Tab S10+ — creative work, S Pen</li>
      </ul>
      <p><em>Prices are indicative MRP. Check Amazon, Flipkart, or brand stores for latest offers.</em></p>
    </div>
  </section>

  <script define:vars={{ laptops }}>
    // Brand filter for model dropdowns
    function filterModels(brandSel, modelSel) {
      const brand = brandSel.value;
      modelSel.querySelectorAll('option[data-brand]').forEach(opt => {
        opt.style.display = (!brand || opt.dataset.brand === brand) ? '' : 'none';
      });
    }

    document.getElementById('lBrand1').addEventListener('change', function() {
      filterModels(this, document.getElementById('device1'));
      document.getElementById('device1').value = '';
    });
    document.getElementById('lBrand2').addEventListener('change', function() {
      filterModels(this, document.getElementById('device2'));
      document.getElementById('device2').value = '';
    });

    document.getElementById('device1').addEventListener('change', function() {
      const opt = this.selectedOptions[0];
      if (opt && opt.dataset.brand) document.getElementById('lBrand1').value = opt.dataset.brand;
    });
    document.getElementById('device2').addEventListener('change', function() {
      const opt = this.selectedOptions[0];
      if (opt && opt.dataset.brand) document.getElementById('lBrand2').value = opt.dataset.brand;
    });

    // Brand tabs
    let activeBrand = 'all';
    let activeCat = 'all';

    function applyFilters() {
      document.querySelectorAll('.laptop-card').forEach(card => {
        const brandMatch = activeBrand === 'all' || card.dataset.brand === activeBrand;
        const catMatch = activeCat === 'all' || card.dataset.cat === activeCat;
        card.style.display = (brandMatch && catMatch) ? '' : 'none';
      });
    }

    document.querySelectorAll('.lbrand-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.lbrand-tab').forEach(t => {
          t.classList.remove('bg-indigo-500', 'text-white');
          t.classList.add('bg-white/[0.06]', 'text-gray-300');
        });
        tab.classList.add('bg-indigo-500', 'text-white');
        tab.classList.remove('bg-white/[0.06]', 'text-gray-300');
        activeBrand = tab.dataset.brand;
        applyFilters();
      });
    });

    document.querySelectorAll('.lcat-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.lcat-tab').forEach(t => {
          t.classList.remove('bg-indigo-500/20', 'text-indigo-400');
          t.classList.add('bg-white/[0.04]', 'text-gray-500');
        });
        tab.classList.add('bg-indigo-500/20', 'text-indigo-400');
        tab.classList.remove('bg-white/[0.04]', 'text-gray-500');
        activeCat = tab.dataset.cat;
        applyFilters();
      });
    });

    // Comparison
    const specs = [
      { key: 'price', label: 'Price', format: v => '₹' + v.toLocaleString('en-IN'), compare: 'lower' },
      { key: 'type', label: 'Type', format: v => v },
      { key: 'category', label: 'Category', format: v => v.charAt(0).toUpperCase() + v.slice(1) },
      { key: 'display', label: 'Display', format: v => v },
      { key: 'displaySize', label: 'Screen Size', format: v => v },
      { key: 'processor', label: 'Processor', format: v => v },
      { key: 'ram', label: 'RAM', format: v => v },
      { key: 'storage', label: 'Storage', format: v => v },
      { key: 'gpu', label: 'GPU', format: v => v },
      { key: 'battery', label: 'Battery', format: v => v },
      { key: 'weight', label: 'Weight', format: v => v },
      { key: 'os', label: 'Operating System', format: v => v },
      { key: 'ports', label: 'Ports', format: v => v },
      { key: 'rating', label: 'Rating', format: v => v + ' / 5', compare: 'higher' },
    ];

    document.getElementById('compareBtn').addEventListener('click', () => {
      const d1 = laptops.find(l => l.id === document.getElementById('device1').value);
      const d2 = laptops.find(l => l.id === document.getElementById('device2').value);
      if (!d1 || !d2) { alert('Please select both devices'); return; }

      const container = document.getElementById('comparison');
      container.classList.remove('hidden');

      let html = `
        <div class="grid grid-cols-3 bg-white/[0.02] border-b border-white/10">
          <div class="p-4 font-semibold text-gray-400 text-sm">Specification</div>
          <div class="p-4 text-center font-bold text-indigo-400">${d1.name}</div>
          <div class="p-4 text-center font-bold text-emerald-400">${d2.name}</div>
        </div>
      `;

      specs.forEach(spec => {
        const v1 = d1[spec.key];
        const v2 = d2[spec.key];
        let c1 = '', c2 = '';
        if (spec.compare && typeof v1 === 'number' && typeof v2 === 'number') {
          if (spec.compare === 'lower') {
            if (v1 < v2) c1 = 'text-emerald-400 font-semibold';
            else if (v2 < v1) c2 = 'text-emerald-400 font-semibold';
          } else {
            if (v1 > v2) c1 = 'text-emerald-400 font-semibold';
            else if (v2 > v1) c2 = 'text-emerald-400 font-semibold';
          }
        }
        html += `
          <div class="grid grid-cols-3 border-b border-white/5 hover:bg-white/[0.02]">
            <div class="p-4 text-sm font-medium text-gray-400">${spec.label}</div>
            <div class="p-4 text-sm text-center ${c1}">${spec.format(v1)}</div>
            <div class="p-4 text-sm text-center ${c2}">${spec.format(v2)}</div>
          </div>
        `;
      });

      container.innerHTML = html;
      container.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // Configuration Suggester
    document.getElementById('suggestBtn').addEventListener('click', () => {
      const budget = parseInt(document.getElementById('sugBudget').value);
      const useCase = document.getElementById('sugUse').value;
      const os = document.getElementById('sugOS').value;

      let candidates = laptops.filter(l => l.type === 'Laptop' && l.price <= budget);

      // Filter by OS
      if (os === 'windows') candidates = candidates.filter(l => l.os.toLowerCase().includes('windows'));
      if (os === 'macos') candidates = candidates.filter(l => l.os.toLowerCase().includes('macos'));

      // Score based on use case
      const scored = candidates.map(l => {
        let score = l.rating * 10;

        if (useCase === 'student') {
          // Prefer: low price, good battery, lightweight
          score += (budget - l.price) / 5000; // cheaper = better
          const battHrs = parseFloat(l.battery) || 0;
          score += battHrs * 2;
        } else if (useCase === 'office') {
          // Prefer: good display, 16GB RAM, SSD
          if (l.ram.includes('16')) score += 10;
          const battHrs = parseFloat(l.battery) || 0;
          score += battHrs;
          if (l.display.toLowerCase().includes('ips') || l.display.toLowerCase().includes('oled')) score += 5;
        } else if (useCase === 'coding') {
          // Prefer: 16GB+ RAM, good keyboard (ThinkPad), Linux-friendly
          if (l.ram.includes('16') || l.ram.includes('18') || l.ram.includes('32') || l.ram.includes('36')) score += 15;
          if (l.name.toLowerCase().includes('thinkpad')) score += 10;
          if (l.storage.includes('512') || l.storage.includes('1 TB')) score += 5;
          const battHrs = parseFloat(l.battery) || 0;
          score += battHrs;
        } else if (useCase === 'creative') {
          // Prefer: powerful GPU, high-res display, lots of RAM
          if (l.display.toLowerCase().includes('oled') || l.display.toLowerCase().includes('retina')) score += 15;
          if (l.ram.includes('16') || l.ram.includes('18') || l.ram.includes('32') || l.ram.includes('36')) score += 10;
          if (l.gpu.toLowerCase().includes('rtx') || l.gpu.toLowerCase().includes('m3 pro') || l.gpu.toLowerCase().includes('m3 max')) score += 15;
        } else if (useCase === 'gaming') {
          // Prefer: dedicated GPU, high refresh display
          if (l.gpu.toLowerCase().includes('rtx 4070')) score += 25;
          else if (l.gpu.toLowerCase().includes('rtx 4060')) score += 20;
          else if (l.gpu.toLowerCase().includes('rtx 4050')) score += 15;
          if (l.display.includes('144Hz') || l.display.includes('165Hz') || l.display.includes('240Hz')) score += 10;
          if (l.ram.includes('16')) score += 5;
        } else if (useCase === 'portable') {
          // Prefer: light weight, long battery, small size
          const wt = parseFloat(l.weight) || 2;
          score += (2.5 - wt) * 15; // lighter = much better
          const battHrs = parseFloat(l.battery) || 0;
          score += battHrs * 2;
        }

        return { ...l, score };
      });

      scored.sort((a, b) => b.score - a.score);
      const results = scored.slice(0, 3);

      const container = document.getElementById('sugCards');
      const resultsDiv = document.getElementById('sugResults');

      if (results.length === 0) {
        container.innerHTML = '<p class="text-gray-500 col-span-3">No laptops found matching your criteria. Try increasing your budget.</p>';
        resultsDiv.classList.remove('hidden');
        return;
      }

      const medals = ['Best Pick', 'Runner-up', 'Also Great'];
      const colors = ['border-amber-400/30 bg-amber-500/10', 'border-white/10 bg-white/[0.04]', 'border-white/10 bg-white/[0.03]'];

      container.innerHTML = results.map((l, i) => `
        <div class="rounded-xl border-2 ${colors[i]} p-5">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-bold px-2 py-0.5 rounded-full ${i === 0 ? 'bg-amber-500/20 text-amber-300' : 'bg-white/10 text-gray-400'}">${medals[i]}</span>
          </div>
          <h4 class="font-bold text-white">${l.name}</h4>
          <p class="text-indigo-400 font-bold mt-1">₹${l.price.toLocaleString('en-IN')}</p>
          <div class="mt-3 space-y-1 text-xs text-gray-400">
            <p><strong>CPU:</strong> ${l.processor}</p>
            <p><strong>RAM:</strong> ${l.ram} | <strong>Storage:</strong> ${l.storage}</p>
            <p><strong>GPU:</strong> ${l.gpu}</p>
            <p><strong>Display:</strong> ${l.displaySize} ${l.display}</p>
            <p><strong>Battery:</strong> ${l.battery} | <strong>Weight:</strong> ${l.weight}</p>
          </div>
          <p class="mt-3 text-xs text-gray-400">Rating: ${l.rating}/5</p>
        </div>
      `).join('');

      resultsDiv.classList.remove('hidden');
      resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>
</Layout>
