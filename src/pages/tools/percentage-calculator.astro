---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Percentage Calculator', url: 'https://comparekaro.download/tools/percentage-calculator', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' } };
---
<Layout title="Percentage Calculator - All % Calculations in One Place" description="Free percentage calculator. Find percentage of a number, increase/decrease, difference, marks percentage, and tip percentage. Works offline." schema={schema}>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4"><a href="/" class="hover:text-indigo-400">Home</a><span class="mx-2">/</span><a href="/tools" class="hover:text-indigo-400">Tools</a><span class="mx-2">/</span><span class="text-white">Percentage Calculator</span></nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Percentage Calculator</h1>
      <p class="text-gray-400 text-lg">Every percentage calculation you'll ever need, in one place.</p>
    </div>

    <!-- Calc 1: What is X% of Y -->
    <div class="glass rounded-2xl p-6 mb-6">
      <h3 class="text-white font-bold mb-4">What is <span class="text-indigo-400">X%</span> of <span class="text-indigo-400">Y</span>?</h3>
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-gray-300">What is</span>
        <input type="number" id="p1x" value="15" class="w-24 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-center text-gray-200" />
        <span class="text-gray-300">% of</span>
        <input type="number" id="p1y" value="2000" class="w-32 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-center text-gray-200" />
        <span class="text-gray-300">=</span>
        <span id="p1r" class="text-xl font-bold text-emerald-400 min-w-[80px]">300</span>
      </div>
    </div>

    <!-- Calc 2: X is what % of Y -->
    <div class="glass rounded-2xl p-6 mb-6">
      <h3 class="text-white font-bold mb-4"><span class="text-indigo-400">X</span> is what % of <span class="text-indigo-400">Y</span>?</h3>
      <div class="flex flex-wrap items-center gap-3">
        <input type="number" id="p2x" value="350" class="w-32 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-center text-gray-200" />
        <span class="text-gray-300">is what % of</span>
        <input type="number" id="p2y" value="2000" class="w-32 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-center text-gray-200" />
        <span class="text-gray-300">=</span>
        <span id="p2r" class="text-xl font-bold text-emerald-400 min-w-[80px]">17.5%</span>
      </div>
    </div>

    <!-- Calc 3: % Increase/Decrease -->
    <div class="glass rounded-2xl p-6 mb-6">
      <h3 class="text-white font-bold mb-4">Percentage <span class="text-indigo-400">Change</span></h3>
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-gray-300">From</span>
        <input type="number" id="p3from" value="500" class="w-32 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-center text-gray-200" />
        <span class="text-gray-300">to</span>
        <input type="number" id="p3to" value="650" class="w-32 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-center text-gray-200" />
        <span class="text-gray-300">=</span>
        <span id="p3r" class="text-xl font-bold text-emerald-400 min-w-[100px]">+30%</span>
      </div>
    </div>

    <!-- Calc 4: Increase/Decrease by % -->
    <div class="glass rounded-2xl p-6 mb-6">
      <h3 class="text-white font-bold mb-4">Increase / Decrease by <span class="text-indigo-400">%</span></h3>
      <div class="flex flex-wrap items-center gap-3">
        <input type="number" id="p4val" value="1000" class="w-32 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-center text-gray-200" />
        <select id="p4dir" class="px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-gray-200 text-sm">
          <option value="increase">+ increase by</option>
          <option value="decrease">- decrease by</option>
        </select>
        <input type="number" id="p4pct" value="20" class="w-24 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-center text-gray-200" />
        <span class="text-gray-300">% =</span>
        <span id="p4r" class="text-xl font-bold text-emerald-400 min-w-[80px]">1200</span>
      </div>
    </div>

    <!-- Calc 5: Marks Percentage -->
    <div class="glass rounded-2xl p-6 mb-6">
      <h3 class="text-white font-bold mb-4">Marks <span class="text-indigo-400">Percentage</span></h3>
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-gray-300">Obtained</span>
        <input type="number" id="p5obt" value="420" class="w-28 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-center text-gray-200" />
        <span class="text-gray-300">out of</span>
        <input type="number" id="p5tot" value="500" class="w-28 px-3 py-2 bg-white/[0.06] border border-white/10 rounded-lg text-center text-gray-200" />
        <span class="text-gray-300">=</span>
        <span id="p5r" class="text-xl font-bold text-emerald-400 min-w-[80px]">84%</span>
        <span id="p5grade" class="text-sm font-medium text-indigo-400 px-2 py-1 bg-indigo-500/10 rounded">-</span>
      </div>
    </div>

    <AdUnit />

    <div class="glass rounded-2xl p-6">
      <h2 class="text-xl font-bold text-white mb-3">Quick Reference</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
        {[{p:'10%',of:'₹1,000',r:'₹100'},{p:'12%',of:'₹5,000',r:'₹600'},{p:'18%',of:'₹10,000',r:'₹1,800'},{p:'28%',of:'₹50,000',r:'₹14,000'},{p:'5%',of:'₹15,000',r:'₹750'},{p:'15%',of:'₹20,000',r:'₹3,000'},{p:'20%',of:'₹1L',r:'₹20,000'},{p:'50%',of:'₹3,000',r:'₹1,500'}].map(q => (
          <div class="p-3 bg-white/[0.03] rounded-lg text-center">
            <span class="text-gray-500">{q.p} of {q.of}</span>
            <p class="font-bold text-white">{q.r}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const f = id => document.getElementById(id);
    function auto() {
      // Calc 1
      const p1 = (parseFloat(f('p1x').value) || 0) / 100 * (parseFloat(f('p1y').value) || 0);
      f('p1r').textContent = p1.toLocaleString('en-IN', {maximumFractionDigits: 2});
      // Calc 2
      const p2y = parseFloat(f('p2y').value) || 1;
      f('p2r').textContent = ((parseFloat(f('p2x').value) || 0) / p2y * 100).toFixed(2) + '%';
      // Calc 3
      const from = parseFloat(f('p3from').value) || 0;
      const to = parseFloat(f('p3to').value) || 0;
      const change = from ? ((to - from) / from * 100) : 0;
      f('p3r').textContent = (change >= 0 ? '+' : '') + change.toFixed(2) + '%';
      f('p3r').className = `text-xl font-bold min-w-[100px] ${change >= 0 ? 'text-emerald-400' : 'text-red-400'}`;
      // Calc 4
      const v = parseFloat(f('p4val').value) || 0;
      const pct = parseFloat(f('p4pct').value) || 0;
      const dir = f('p4dir').value;
      f('p4r').textContent = (dir === 'increase' ? v * (1 + pct/100) : v * (1 - pct/100)).toLocaleString('en-IN', {maximumFractionDigits: 2});
      // Calc 5
      const obt = parseFloat(f('p5obt').value) || 0;
      const tot = parseFloat(f('p5tot').value) || 1;
      const marks = obt / tot * 100;
      f('p5r').textContent = marks.toFixed(1) + '%';
      let grade = marks >= 90 ? 'A+' : marks >= 80 ? 'A' : marks >= 70 ? 'B+' : marks >= 60 ? 'B' : marks >= 50 ? 'C' : marks >= 40 ? 'D' : 'F';
      f('p5grade').textContent = 'Grade: ' + grade;
    }
    document.querySelectorAll('input, select').forEach(el => el.addEventListener('input', auto));
    auto();
  </script>
</Layout>
