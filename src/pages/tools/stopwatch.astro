---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';
const schema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Stopwatch & Timer', url: 'https://comparekaro.download/tools/stopwatch', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' } };
---
<Layout title="Stopwatch & Timer - Online Countdown Timer & Stopwatch" description="Free online stopwatch with lap times and countdown timer. Set custom timers, track laps. Works in your browser, even offline." schema={schema}>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4"><a href="/" class="hover:text-indigo-400">Home</a><span class="mx-2">/</span><a href="/tools" class="hover:text-indigo-400">Tools</a><span class="mx-2">/</span><span class="text-white">Stopwatch & Timer</span></nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Stopwatch & Timer</h1>
    </div>

    <!-- Mode tabs -->
    <div class="flex gap-2 mb-6">
      <button class="mode-tab px-5 py-2 rounded-full text-sm font-medium bg-indigo-500 text-white" data-mode="stopwatch">Stopwatch</button>
      <button class="mode-tab px-5 py-2 rounded-full text-sm font-medium bg-white/[0.06] text-gray-300" data-mode="timer">Timer</button>
    </div>

    <!-- Stopwatch -->
    <div id="mode-stopwatch" class="glass rounded-2xl p-8 mb-8 text-center">
      <div id="swDisplay" class="text-6xl md:text-8xl font-mono font-bold text-white tracking-wider mb-8">00:00.00</div>
      <div class="flex justify-center gap-4 mb-6">
        <button id="swStart" class="px-8 py-3 bg-emerald-500 hover:bg-emerald-400 text-white font-bold rounded-xl shadow-lg shadow-emerald-500/20 transition-all cursor-pointer text-lg">Start</button>
        <button id="swLap" class="px-8 py-3 bg-white/[0.06] text-gray-300 font-bold rounded-xl border border-white/10 transition-all cursor-pointer text-lg" disabled>Lap</button>
        <button id="swReset" class="px-8 py-3 bg-white/[0.06] text-gray-300 font-bold rounded-xl border border-white/10 transition-all cursor-pointer text-lg">Reset</button>
      </div>
      <div id="laps" class="max-h-60 overflow-y-auto space-y-1"></div>
    </div>

    <!-- Timer -->
    <div id="mode-timer" class="hidden glass rounded-2xl p-8 mb-8 text-center">
      <div id="timerSetup">
        <div class="flex justify-center gap-4 mb-6">
          <div><label class="block text-xs text-gray-500 mb-1">Hours</label><input type="number" id="tHrs" value="0" min="0" max="23" class="w-20 px-3 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-2xl text-gray-200 text-center font-mono" /></div>
          <div><label class="block text-xs text-gray-500 mb-1">Minutes</label><input type="number" id="tMin" value="5" min="0" max="59" class="w-20 px-3 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-2xl text-gray-200 text-center font-mono" /></div>
          <div><label class="block text-xs text-gray-500 mb-1">Seconds</label><input type="number" id="tSec" value="0" min="0" max="59" class="w-20 px-3 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-2xl text-gray-200 text-center font-mono" /></div>
        </div>
        <div class="flex flex-wrap justify-center gap-2 mb-6">
          {[1, 2, 3, 5, 10, 15, 20, 25, 30, 45, 60].map(m => (
            <button class="preset-timer px-4 py-2 rounded-lg bg-white/[0.04] text-gray-400 text-sm font-medium hover:bg-indigo-500/20 hover:text-indigo-400 transition-all cursor-pointer" data-min={m}>{m < 60 ? `${m}m` : '1h'}</button>
          ))}
        </div>
      </div>
      <div id="timerDisplay" class="hidden text-6xl md:text-8xl font-mono font-bold text-white tracking-wider mb-8">05:00</div>
      <div class="flex justify-center gap-4">
        <button id="tStart" class="px-8 py-3 bg-emerald-500 hover:bg-emerald-400 text-white font-bold rounded-xl shadow-lg shadow-emerald-500/20 transition-all cursor-pointer text-lg">Start</button>
        <button id="tPause" class="hidden px-8 py-3 bg-yellow-500 hover:bg-yellow-400 text-white font-bold rounded-xl transition-all cursor-pointer text-lg">Pause</button>
        <button id="tReset" class="px-8 py-3 bg-white/[0.06] text-gray-300 font-bold rounded-xl border border-white/10 transition-all cursor-pointer text-lg">Reset</button>
      </div>
    </div>

    <AdUnit />
  </section>

  <script>
    const f = id => document.getElementById(id);
    // Mode switch
    document.querySelectorAll('.mode-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.mode-tab').forEach(t => { t.classList.remove('bg-indigo-500','text-white'); t.classList.add('bg-white/[0.06]','text-gray-300'); });
        tab.classList.add('bg-indigo-500','text-white'); tab.classList.remove('bg-white/[0.06]','text-gray-300');
        f('mode-stopwatch').classList.toggle('hidden', tab.dataset.mode !== 'stopwatch');
        f('mode-timer').classList.toggle('hidden', tab.dataset.mode !== 'timer');
      });
    });

    // ─── STOPWATCH ───
    let swRunning = false, swStart = 0, swElapsed = 0, swInterval, lapCount = 0, lastLap = 0;
    function fmtSw(ms) {
      const m = Math.floor(ms / 60000);
      const s = Math.floor((ms % 60000) / 1000);
      const cs = Math.floor((ms % 1000) / 10);
      return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}.${String(cs).padStart(2,'0')}`;
    }
    function updateSw() { f('swDisplay').textContent = fmtSw(swElapsed + (Date.now() - swStart)); }

    f('swStart').addEventListener('click', () => {
      if (!swRunning) {
        swRunning = true; swStart = Date.now();
        swInterval = setInterval(updateSw, 10);
        f('swStart').textContent = 'Stop'; f('swStart').classList.replace('bg-emerald-500','bg-red-500'); f('swStart').classList.replace('hover:bg-emerald-400','hover:bg-red-400'); f('swStart').classList.replace('shadow-emerald-500/20','shadow-red-500/20');
        f('swLap').disabled = false;
      } else {
        swRunning = false; swElapsed += Date.now() - swStart;
        clearInterval(swInterval);
        f('swStart').textContent = 'Start'; f('swStart').classList.replace('bg-red-500','bg-emerald-500'); f('swStart').classList.replace('hover:bg-red-400','hover:bg-emerald-400'); f('swStart').classList.replace('shadow-red-500/20','shadow-emerald-500/20');
        f('swLap').disabled = true;
      }
    });
    f('swLap').addEventListener('click', () => {
      if (!swRunning) return;
      lapCount++;
      const total = swElapsed + (Date.now() - swStart);
      const lapTime = total - lastLap;
      lastLap = total;
      const div = document.createElement('div');
      div.className = 'flex justify-between px-4 py-2 bg-white/[0.03] rounded-lg text-sm';
      div.innerHTML = `<span class="text-gray-400">Lap ${lapCount}</span><span class="text-indigo-400 font-mono">${fmtSw(lapTime)}</span><span class="text-white font-mono">${fmtSw(total)}</span>`;
      f('laps').prepend(div);
    });
    f('swReset').addEventListener('click', () => {
      swRunning = false; swElapsed = 0; lapCount = 0; lastLap = 0;
      clearInterval(swInterval);
      f('swDisplay').textContent = '00:00.00';
      f('swStart').textContent = 'Start'; f('swStart').classList.replace('bg-red-500','bg-emerald-500'); f('swStart').classList.replace('hover:bg-red-400','hover:bg-emerald-400');
      f('swLap').disabled = true;
      f('laps').innerHTML = '';
    });

    // ─── TIMER ───
    let tRunning = false, tRemaining = 0, tInterval;
    function fmtTimer(s) {
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = s % 60;
      return h > 0 ? `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}` : `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
    }
    function tickTimer() {
      if (tRemaining <= 0) {
        clearInterval(tInterval); tRunning = false;
        f('timerDisplay').textContent = '00:00';
        f('timerDisplay').classList.add('text-red-400');
        f('tStart').classList.remove('hidden'); f('tPause').classList.add('hidden');
        // Alert
        try { new Audio('data:audio/wav;base64,UklGRl9vT19telegramBABhBACABAAlEiAAAA==').play(); } catch(e) {}
        alert('Timer finished!');
        return;
      }
      tRemaining--;
      f('timerDisplay').textContent = fmtTimer(tRemaining);
    }

    f('tStart').addEventListener('click', () => {
      if (!tRunning) {
        if (tRemaining <= 0) {
          tRemaining = (parseInt(f('tHrs').value) || 0) * 3600 + (parseInt(f('tMin').value) || 0) * 60 + (parseInt(f('tSec').value) || 0);
          if (tRemaining <= 0) return;
        }
        tRunning = true;
        f('timerSetup').classList.add('hidden');
        f('timerDisplay').classList.remove('hidden','text-red-400');
        f('timerDisplay').textContent = fmtTimer(tRemaining);
        tInterval = setInterval(tickTimer, 1000);
        f('tStart').classList.add('hidden'); f('tPause').classList.remove('hidden');
      }
    });
    f('tPause').addEventListener('click', () => {
      tRunning = false; clearInterval(tInterval);
      f('tStart').classList.remove('hidden'); f('tPause').classList.add('hidden');
    });
    f('tReset').addEventListener('click', () => {
      tRunning = false; tRemaining = 0; clearInterval(tInterval);
      f('timerSetup').classList.remove('hidden');
      f('timerDisplay').classList.add('hidden');
      f('timerDisplay').classList.remove('text-red-400');
      f('tStart').classList.remove('hidden'); f('tPause').classList.add('hidden');
    });
    document.querySelectorAll('.preset-timer').forEach(btn => {
      btn.addEventListener('click', () => {
        const m = parseInt(btn.dataset.min);
        f('tHrs').value = Math.floor(m / 60);
        f('tMin').value = m % 60;
        f('tSec').value = 0;
      });
    });
  </script>
</Layout>
