---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Age Calculator',
  url: 'https://comparekaro.download/tools/age-calculator',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};
---

<Layout
  title="Age Calculator - Exact Age in Years, Months, Days"
  description="Free age calculator. Enter your birthday to get exact age in years, months and days. Zodiac sign, life statistics, next birthday countdown and more."
  schema={schema}
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-indigo-400">Home</a>
        <span class="mx-2">/</span>
        <a href="/tools" class="hover:text-indigo-400">Tools</a>
        <span class="mx-2">/</span>
        <span class="text-white">Age Calculator</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Age Calculator</h1>
      <p class="text-gray-400 text-lg">Enter your date of birth to find your exact age, zodiac sign, and fun life statistics.</p>
    </div>

    <!-- Calculator -->
    <div class="glass rounded-2xl p-6 md:p-8 mb-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-2">Date of Birth</label>
          <input type="date" id="dob" class="w-full px-4 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-lg text-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-2">Calculate Age On</label>
          <input type="date" id="targetDate" class="w-full px-4 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-lg text-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
        </div>
      </div>
      <button id="calcBtn" class="px-8 py-3 bg-gradient-to-r from-indigo-500 to-pink-500 hover:from-indigo-400 hover:to-pink-400 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/25 transition-all cursor-pointer">
        Calculate Age
      </button>
    </div>

    <!-- Results -->
    <div id="results" class="hidden space-y-6">
      <!-- Main Age -->
      <div class="glass rounded-2xl p-6 text-center">
        <p class="text-gray-400 text-sm mb-2">Your Age</p>
        <div class="flex justify-center items-baseline gap-4 flex-wrap">
          <div>
            <span id="ageYears" class="text-5xl font-extrabold gradient-text">0</span>
            <span class="text-gray-400 text-lg ml-1">years</span>
          </div>
          <div>
            <span id="ageMonths" class="text-3xl font-bold text-white">0</span>
            <span class="text-gray-400 ml-1">months</span>
          </div>
          <div>
            <span id="ageDays" class="text-3xl font-bold text-white">0</span>
            <span class="text-gray-400 ml-1">days</span>
          </div>
        </div>
      </div>

      <!-- Quick Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="glass rounded-xl p-4 text-center">
          <p class="text-gray-500 text-xs">Total Months</p>
          <p id="totalMonths" class="text-xl font-bold text-indigo-400 mt-1">0</p>
        </div>
        <div class="glass rounded-xl p-4 text-center">
          <p class="text-gray-500 text-xs">Total Weeks</p>
          <p id="totalWeeks" class="text-xl font-bold text-emerald-400 mt-1">0</p>
        </div>
        <div class="glass rounded-xl p-4 text-center">
          <p class="text-gray-500 text-xs">Total Days</p>
          <p id="totalDays" class="text-xl font-bold text-pink-400 mt-1">0</p>
        </div>
        <div class="glass rounded-xl p-4 text-center">
          <p class="text-gray-500 text-xs">Total Hours</p>
          <p id="totalHours" class="text-xl font-bold text-amber-400 mt-1">0</p>
        </div>
      </div>

      <!-- Zodiac & Birthday -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="glass rounded-xl p-5">
          <h3 class="font-bold text-white mb-3">Zodiac Sign</h3>
          <div class="flex items-center gap-3">
            <span id="zodiacEmoji" class="text-4xl">♈</span>
            <div>
              <p id="zodiacName" class="text-lg font-bold text-indigo-400">Aries</p>
              <p id="zodiacDates" class="text-sm text-gray-400">Mar 21 - Apr 19</p>
            </div>
          </div>
        </div>
        <div class="glass rounded-xl p-5">
          <h3 class="font-bold text-white mb-3">Next Birthday</h3>
          <p id="nextBday" class="text-lg font-bold text-pink-400">-</p>
          <p id="nextBdayDay" class="text-sm text-gray-400 mt-1">-</p>
          <p id="turningAge" class="text-sm text-gray-500 mt-1">-</p>
        </div>
      </div>

      <AdUnit />

      <!-- Life Statistics -->
      <div class="glass rounded-2xl p-6">
        <h3 class="font-bold text-white mb-4 text-lg">Fun Life Statistics</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="lifeStats"></div>
      </div>

      <!-- Day Born -->
      <div class="glass rounded-xl p-5">
        <h3 class="font-bold text-white mb-3">Born On</h3>
        <p id="bornDay" class="text-indigo-400 font-medium">-</p>
        <p id="bornFact" class="text-sm text-gray-400 mt-1">-</p>
      </div>
    </div>

    <AdUnit />

    <div class="mt-12 glass rounded-2xl p-6 md:p-8">
      <h2 class="text-xl font-bold text-white mb-3">How Age is Calculated</h2>
      <p class="text-gray-400 text-sm leading-relaxed mb-3">Age is calculated by finding the difference between the date of birth and the current date (or target date). The calculator accounts for varying month lengths, leap years, and provides the exact age in years, months, and days.</p>
      <h3 class="text-lg font-bold text-white mt-4 mb-2">Zodiac Signs</h3>
      <p class="text-gray-400 text-sm leading-relaxed">Your zodiac sign (also called sun sign) is determined by your date of birth. There are 12 zodiac signs, each spanning approximately one month of the year.</p>
    </div>
  </section>

  <script>
    const today = new Date();
    document.getElementById('targetDate').valueAsDate = today;

    const zodiacSigns = [
      { name: 'Capricorn', emoji: '♑', start: [1,1], end: [1,19], dates: 'Dec 22 - Jan 19' },
      { name: 'Aquarius', emoji: '♒', start: [1,20], end: [2,18], dates: 'Jan 20 - Feb 18' },
      { name: 'Pisces', emoji: '♓', start: [2,19], end: [3,20], dates: 'Feb 19 - Mar 20' },
      { name: 'Aries', emoji: '♈', start: [3,21], end: [4,19], dates: 'Mar 21 - Apr 19' },
      { name: 'Taurus', emoji: '♉', start: [4,20], end: [5,20], dates: 'Apr 20 - May 20' },
      { name: 'Gemini', emoji: '♊', start: [5,21], end: [6,20], dates: 'May 21 - Jun 20' },
      { name: 'Cancer', emoji: '♋', start: [6,21], end: [7,22], dates: 'Jun 21 - Jul 22' },
      { name: 'Leo', emoji: '♌', start: [7,23], end: [8,22], dates: 'Jul 23 - Aug 22' },
      { name: 'Virgo', emoji: '♍', start: [8,23], end: [9,22], dates: 'Aug 23 - Sep 22' },
      { name: 'Libra', emoji: '♎', start: [9,23], end: [10,22], dates: 'Sep 23 - Oct 22' },
      { name: 'Scorpio', emoji: '♏', start: [10,23], end: [11,21], dates: 'Oct 23 - Nov 21' },
      { name: 'Sagittarius', emoji: '♐', start: [11,22], end: [12,21], dates: 'Nov 22 - Dec 21' },
      { name: 'Capricorn', emoji: '♑', start: [12,22], end: [12,31], dates: 'Dec 22 - Jan 19' },
    ];

    function getZodiac(month, day) {
      for (const z of zodiacSigns) {
        const [sm, sd] = z.start;
        const [em, ed] = z.end;
        if ((month === sm && day >= sd) || (month === em && day <= ed)) return z;
      }
      return zodiacSigns[0];
    }

    const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    function calcAge(dob, target) {
      let years = target.getFullYear() - dob.getFullYear();
      let months = target.getMonth() - dob.getMonth();
      let days = target.getDate() - dob.getDate();

      if (days < 0) {
        months--;
        const prevMonth = new Date(target.getFullYear(), target.getMonth(), 0);
        days += prevMonth.getDate();
      }
      if (months < 0) {
        years--;
        months += 12;
      }
      return { years, months, days };
    }

    document.getElementById('calcBtn').addEventListener('click', () => {
      const dobInput = document.getElementById('dob').value;
      const targetInput = document.getElementById('targetDate').value;
      if (!dobInput) { alert('Please enter your date of birth'); return; }

      const dob = new Date(dobInput);
      const target = targetInput ? new Date(targetInput) : new Date();

      if (dob >= target) { alert('Date of birth must be before the target date'); return; }

      const age = calcAge(dob, target);
      const diffMs = target - dob;
      const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      const totalHours = totalDays * 24;
      const totalWeeks = Math.floor(totalDays / 7);
      const totalMonths = age.years * 12 + age.months;

      document.getElementById('ageYears').textContent = age.years;
      document.getElementById('ageMonths').textContent = age.months;
      document.getElementById('ageDays').textContent = age.days;
      document.getElementById('totalMonths').textContent = totalMonths.toLocaleString('en-IN');
      document.getElementById('totalWeeks').textContent = totalWeeks.toLocaleString('en-IN');
      document.getElementById('totalDays').textContent = totalDays.toLocaleString('en-IN');
      document.getElementById('totalHours').textContent = totalHours.toLocaleString('en-IN');

      // Zodiac
      const zodiac = getZodiac(dob.getMonth() + 1, dob.getDate());
      document.getElementById('zodiacEmoji').textContent = zodiac.emoji;
      document.getElementById('zodiacName').textContent = zodiac.name;
      document.getElementById('zodiacDates').textContent = zodiac.dates;

      // Next birthday
      let nextBday = new Date(target.getFullYear(), dob.getMonth(), dob.getDate());
      if (nextBday <= target) nextBday.setFullYear(nextBday.getFullYear() + 1);
      const daysUntil = Math.ceil((nextBday - target) / (1000 * 60 * 60 * 24));
      const turningAge = nextBday.getFullYear() - dob.getFullYear();
      document.getElementById('nextBday').textContent = `${daysUntil} days away`;
      document.getElementById('nextBdayDay').textContent = `${dayNames[nextBday.getDay()]}, ${nextBday.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}`;
      document.getElementById('turningAge').textContent = `You'll turn ${turningAge}`;

      // Born on
      document.getElementById('bornDay').textContent = `${dayNames[dob.getDay()]}, ${dob.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}`;

      const generation = dob.getFullYear() <= 1964 ? 'Baby Boomer' :
        dob.getFullYear() <= 1980 ? 'Gen X' :
        dob.getFullYear() <= 1996 ? 'Millennial' :
        dob.getFullYear() <= 2012 ? 'Gen Z' : 'Gen Alpha';
      document.getElementById('bornFact').textContent = `Generation: ${generation}`;

      // Life stats
      const heartbeats = totalDays * 100000;
      const breaths = totalDays * 23040;
      const sleepYears = (totalDays / 365.25 * 8 / 24).toFixed(1);
      const meals = totalDays * 3;
      const moonOrbits = (totalDays / 27.3).toFixed(0);
      const earthOrbits = (totalDays / 365.25).toFixed(1);
      const blinks = totalDays * 28800;
      const laughs = totalDays * 15;

      const stats = [
        { label: 'Heartbeats', value: heartbeats.toLocaleString('en-IN'), icon: '💓' },
        { label: 'Breaths Taken', value: breaths.toLocaleString('en-IN'), icon: '🌬️' },
        { label: 'Years Sleeping', value: `~${sleepYears} years`, icon: '😴' },
        { label: 'Meals Eaten', value: `~${meals.toLocaleString('en-IN')}`, icon: '🍛' },
        { label: 'Moon Orbits', value: moonOrbits, icon: '🌙' },
        { label: 'Earth Orbits', value: earthOrbits, icon: '🌍' },
        { label: 'Eye Blinks', value: blinks.toLocaleString('en-IN'), icon: '👁️' },
        { label: 'Times Laughed', value: `~${laughs.toLocaleString('en-IN')}`, icon: '😂' },
      ];

      document.getElementById('lifeStats').innerHTML = stats.map(s => `
        <div class="flex items-center gap-3 bg-white/[0.03] rounded-lg p-3">
          <span class="text-2xl">${s.icon}</span>
          <div>
            <p class="text-white font-bold text-sm">${s.value}</p>
            <p class="text-gray-500 text-xs">${s.label}</p>
          </div>
        </div>
      `).join('');

      document.getElementById('results').classList.remove('hidden');
      document.getElementById('results').scrollIntoView({ behavior: 'smooth' });
    });
  </script>
</Layout>
