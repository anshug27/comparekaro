---
import Layout from '../../layouts/Layout.astro';
import AdUnit from '../../components/AdUnit.astro';
import { phones, brands } from '../../data/phones';
import comparisons from '../../data/comparisons.json';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Phone & Laptop Comparison Tool',
  url: 'https://comparekaro.download/compare',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};

// Group phones by brand
const phonesByBrand: Record<string, typeof phones> = {};
for (const phone of phones) {
  if (!phonesByBrand[phone.brand]) phonesByBrand[phone.brand] = [];
  phonesByBrand[phone.brand].push(phone);
}

const sortedBrands = [...brands].sort((a, b) => (phonesByBrand[b]?.length || 0) - (phonesByBrand[a]?.length || 0));
---

<Layout
  title="Compare Phones & Laptops Side by Side - Specs, Price & Features"
  description={`Compare ${phones.length}+ phones and 30+ laptops side by side. Samsung vs Apple vs OnePlus vs Xiaomi - specs, price, camera, battery. Amazon & Flipkart prices.`}
  schema={schema}
  ogImage="/og/phones.png"
>
  <!-- Hero -->
  <div class="page-header-bg relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><line x1=%220%22 y1=%220%22 x2=%2260%22 y2=%220%22 stroke=%22white%22 stroke-width=%220.5%22/><line x1=%220%22 y1=%220%22 x2=%220%22 y2=%2260%22 stroke=%22white%22 stroke-width=%220.5%22/></svg>');"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <nav class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-indigo-400 transition-colors">Home</a>
        <span class="mx-2 text-gray-600">/</span>
        <span class="text-gray-300">Compare</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-3">
        <span class="text-white">Compare </span><span class="gradient-text">Devices</span>
      </h1>
      <p class="text-gray-400 text-lg max-w-2xl">{phones.length} phones across {brands.length} brands. Select two devices to compare specs, prices, and features side by side.</p>

      <!-- Quick category links -->
      <div class="flex flex-wrap gap-3 mt-6">
        <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-gradient-to-r from-indigo-500 to-pink-500 text-white text-sm font-semibold rounded-full shadow-lg shadow-indigo-500/20">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          Phones ({phones.length})
        </span>
        <a href="/tools/laptop-compare" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white/[0.06] text-gray-300 text-sm font-semibold rounded-full border border-white/10 hover:bg-white/[0.10] hover:border-indigo-500/30 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Laptops & Tablets
        </a>
        <a href="/tools/car-compare" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white/[0.06] text-gray-300 text-sm font-semibold rounded-full border border-white/10 hover:bg-white/[0.10] hover:border-indigo-500/30 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 17h.01M16 17h.01M3 11l1.5-5A2 2 0 016.4 4h11.2a2 2 0 011.9 1.5L21 11M3 11v5a1 1 0 001 1h1a2 2 0 002-2 2 2 0 012-2h6a2 2 0 012 2 2 2 0 002 2h1a1 1 0 001-1v-5M3 11h18"/></svg>
          Cars
        </a>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-[#0a0a1a] to-transparent"></div>
  </div>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Compare Tool -->
    <div class="glass rounded-2xl p-6 md:p-8 mb-10 fade-up">
      <h2 class="text-xl font-extrabold text-white mb-6 flex items-center gap-2">
        <svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        Quick Compare
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
        <!-- Phone 1 -->
        <div class="space-y-3">
          <div class="flex items-center gap-2 mb-1">
            <span class="bg-indigo-500/20 text-indigo-400 w-6 h-6 rounded-full inline-flex items-center justify-center text-sm font-bold">1</span>
            <span class="font-bold text-white text-sm">First Phone</span>
          </div>
          <select id="brand1" class="w-full px-4 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-sm text-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 hover:bg-white/[0.08] transition-colors">
            <option value="">Select Brand</option>
            {sortedBrands.map(b => <option value={b}>{b} ({phonesByBrand[b].length})</option>)}
          </select>
          <select id="phone1" class="w-full px-4 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-sm text-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 hover:bg-white/[0.08] transition-colors">
            <option value="">Select Model</option>
            {phones.map(p => <option value={p.id} data-brand={p.brand}>{p.name} - &#8377;{p.price.toLocaleString('en-IN')}</option>)}
          </select>
        </div>
        <!-- Phone 2 -->
        <div class="space-y-3">
          <div class="flex items-center gap-2 mb-1">
            <span class="bg-emerald-500/20 text-emerald-400 w-6 h-6 rounded-full inline-flex items-center justify-center text-sm font-bold">2</span>
            <span class="font-bold text-white text-sm">Second Phone</span>
          </div>
          <select id="brand2" class="w-full px-4 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-sm text-gray-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 hover:bg-white/[0.08] transition-colors">
            <option value="">Select Brand</option>
            {sortedBrands.map(b => <option value={b}>{b} ({phonesByBrand[b].length})</option>)}
          </select>
          <select id="phone2" class="w-full px-4 py-3 bg-white/[0.06] border border-white/10 rounded-xl text-sm text-gray-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 hover:bg-white/[0.08] transition-colors">
            <option value="">Select Model</option>
            {phones.map(p => <option value={p.id} data-brand={p.brand}>{p.name} - &#8377;{p.price.toLocaleString('en-IN')}</option>)}
          </select>
        </div>
      </div>
      <button id="compareBtn" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-10 py-3.5 bg-gradient-to-r from-indigo-500 to-pink-500 hover:from-indigo-400 hover:to-pink-400 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/25 hover:-translate-y-0.5 transition-all cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        Compare Now
      </button>
    </div>

    <!-- Comparison Table -->
    <div id="comparison" class="glass rounded-2xl overflow-hidden hidden mb-10"></div>

    <AdUnit />

    <!-- Search -->
    <div class="mt-10 mb-6">
      <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" id="phoneSearch" placeholder="Search phones... (e.g. iPhone 16, Galaxy S25, POCO)" class="w-full pl-12 pr-4 py-3.5 bg-white/[0.04] border border-white/10 rounded-xl text-sm text-gray-200 placeholder-gray-500 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" />
      </div>
    </div>

    <!-- Browse by Brand -->
    <div>
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-2xl font-extrabold text-white">Browse {phones.length} Phones</h2>
        <span id="phoneCount" class="text-sm text-gray-500 font-medium">{phones.length} phones</span>
      </div>

      <!-- Brand pills -->
      <div class="flex flex-wrap gap-2 mb-8" id="brandTabs">
        <button class="brand-tab active px-4 py-2 rounded-full text-sm font-semibold transition-all" data-brand="all">
          All ({phones.length})
        </button>
        {sortedBrands.map(b => (
          <button class="brand-tab px-4 py-2 rounded-full text-sm font-semibold transition-all" data-brand={b}>
            {b} ({phonesByBrand[b].length})
          </button>
        ))}
      </div>
      <style>{`
        .brand-tab { background: rgba(255,255,255,0.04); color: #9ca3af; border: 1px solid rgba(255,255,255,0.08); }
        .brand-tab:hover { border-color: rgba(99,102,241,0.3); color: #d1d5db; background: rgba(255,255,255,0.06); }
        .brand-tab.active { background: linear-gradient(to right, #6366f1, #ec4899); color: white; border-color: transparent; box-shadow: 0 4px 15px rgba(99,102,241,0.3); }
      `}</style>

      <!-- Phone Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="phoneGrid">
        {phones.sort((a, b) => a.price - b.price).map(p => (
          <div class="phone-card group flex flex-col glass rounded-2xl overflow-hidden hover:bg-white/[0.06] hover:border-indigo-500/20 hover:-translate-y-1 transition-all duration-300" data-brand={p.brand} data-name={p.name.toLowerCase()}>
            <!-- Image + Header -->
            <div class="px-5 pt-5 pb-3">
              <div class="flex gap-4 items-start">
                {p.image && (
                  <div class="shrink-0 w-20 h-20 bg-white/[0.06] rounded-xl overflow-hidden flex items-center justify-center">
                    <img src={p.image} alt={p.name} class="w-full h-full object-contain" loading="lazy" />
                  </div>
                )}
                <div class="min-w-0 flex-1">
                  <p class="text-[11px] uppercase tracking-wider text-indigo-400 font-bold">{p.brand}</p>
                  <h3 class="font-bold text-white leading-snug mt-0.5">{p.name}</h3>
                  <div class="mt-1">
                    <span class="text-lg text-white font-extrabold">&#8377;{p.price.toLocaleString('en-IN')}</span>
                    {(p.amazonPrice > 0 || p.flipkartPrice > 0) 
                      ? <span class="text-[10px] text-emerald-400 font-medium ml-1">Verified</span>
                      : <span class="text-[10px] text-amber-400 font-medium ml-1">Expected</span>
                    }
                  </div>
                </div>
              </div>
            </div>
            <!-- Specs -->
            <div class="px-5 pb-3 flex-1">
              <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
                {p.processor && <div class="flex flex-col"><span class="text-gray-600 text-[10px] uppercase tracking-wider">Processor</span><span class="text-gray-300 font-medium">{p.processor}</span></div>}
                {p.ram && <div class="flex flex-col"><span class="text-gray-600 text-[10px] uppercase tracking-wider">RAM</span><span class="text-gray-300 font-medium">{p.ram}</span></div>}
                {p.mainCamera && <div class="flex flex-col"><span class="text-gray-600 text-[10px] uppercase tracking-wider">Camera</span><span class="text-gray-300 font-medium">{p.mainCamera}</span></div>}
                {p.battery && <div class="flex flex-col"><span class="text-gray-600 text-[10px] uppercase tracking-wider">Battery</span><span class="text-gray-300 font-medium">{p.battery}</span></div>}
                {p.displaySize && <div class="flex flex-col"><span class="text-gray-600 text-[10px] uppercase tracking-wider">Display</span><span class="text-gray-300 font-medium">{p.displaySize}</span></div>}
                {p.has5G && <div class="flex items-end"><span class="inline-flex items-center px-2 py-0.5 bg-emerald-500/10 text-emerald-400 rounded-full text-[10px] font-bold border border-emerald-500/20">5G</span></div>}
              </div>
            </div>
            <!-- Buy Buttons -->
            <div class="px-5 pb-5 pt-2 border-t border-white/5 space-y-2">
              {p.amazonPrice > 0 && (
                <a href={`https://www.amazon.in/s?k=${encodeURIComponent(p.name)}&tag=comparekaro03-21`} target="_blank" rel="nofollow sponsored" class="flex items-center justify-between w-full bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors border border-amber-500/20">
                  <span class="flex items-center gap-1.5">Amazon</span>
                  <span>&#8377;{p.amazonPrice.toLocaleString('en-IN')}</span>
                </a>
              )}
              {p.flipkartPrice > 0 && (
                <a href={`https://www.flipkart.com/search?q=${encodeURIComponent(p.name)}`} target="_blank" rel="nofollow" class="flex items-center justify-between w-full bg-blue-500/20 hover:bg-blue-500/30 text-blue-300 text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors border border-blue-500/20">
                  <span>Flipkart</span>
                  <span>&#8377;{p.flipkartPrice.toLocaleString('en-IN')}</span>
                </a>
              )}
              {!p.amazonPrice && !p.flipkartPrice && (
                <a href={`https://www.amazon.in/s?k=${encodeURIComponent(p.name)}&tag=comparekaro03-21`} target="_blank" rel="nofollow sponsored" class="block w-full text-center bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors border border-amber-500/20">
                  Check Price on Amazon
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <AdUnit />

    <!-- Popular Comparisons -->
    <div class="mt-16 fade-up">
      <h2 class="text-2xl font-extrabold text-white mb-6">Popular Comparisons</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 stagger">
        {comparisons.slice(0, 15).map(c => {
          const cp1 = phones.find(p => p.id === c.phone1Id);
          const cp2 = phones.find(p => p.id === c.phone2Id);
          if (!cp1 || !cp2) return null;
          return (
            <a href={`/compare/${c.slug}`} class="group block glass rounded-2xl p-5 hover:bg-white/[0.06] hover:border-indigo-500/20 transition-all duration-300">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-sm font-bold text-indigo-400">{cp1.brand}</span>
                <span class="text-gray-600 text-xs">vs</span>
                <span class="text-sm font-bold text-emerald-400">{cp2.brand}</span>
              </div>
              <p class="font-bold text-white group-hover:text-indigo-300 transition-colors">{cp1.name} vs {cp2.name}</p>
              <p class="text-sm text-gray-500 mt-1">&#8377;{cp1.price.toLocaleString('en-IN')} vs &#8377;{cp2.price.toLocaleString('en-IN')}</p>
            </a>
          );
        })}
      </div>
    </div>

    <AdUnit />

    <!-- SEO Content -->
    <div class="mt-16 glass rounded-2xl p-6 md:p-8">
      <h2 class="text-xl font-bold text-white mb-3">How to Choose the Right Phone</h2>
      <p class="text-gray-400 text-sm leading-relaxed mb-3">Browse {phones.length} phones from {brands.length} brands including {sortedBrands.slice(0, 5).join(', ')} and more. Select a brand above to filter, or use the comparison tool to compare any two phones side by side.</p>
      <ul class="text-gray-400 text-sm space-y-2 mb-3 list-disc list-inside">
        <li><strong class="text-gray-300">Camera:</strong> Higher MP count, multiple lenses, and OIS for better photos.</li>
        <li><strong class="text-gray-300">Performance:</strong> Snapdragon 8 series or Apple A-series for flagship performance.</li>
        <li><strong class="text-gray-300">Battery:</strong> 5000+ mAh with fast charging (65W+) for all-day usage.</li>
        <li><strong class="text-gray-300">Display:</strong> AMOLED/OLED with 120Hz for the best viewing experience.</li>
        <li><strong class="text-gray-300">Value:</strong> Compare specs at similar prices to find the best deal.</li>
      </ul>
      <p class="text-gray-500 text-xs italic">Phone data auto-updated from 91mobiles.com. Prices show the lowest available from Amazon/Flipkart.</p>
      <p class="text-gray-500 text-sm mt-2">Also compare: <a href="/tools/laptop-compare" class="text-indigo-400 hover:text-indigo-300">Laptops & Tablets</a> | <a href="/tools/car-compare" class="text-indigo-400 hover:text-indigo-300">Cars</a></p>
    </div>
  </section>

  <script define:vars={{ phones }}>
    // Brand filter for model dropdowns
    function filterModels(brandSelect, modelSelect) {
      const brand = brandSelect.value;
      const options = modelSelect.querySelectorAll('option[data-brand]');
      options.forEach(opt => {
        opt.style.display = (!brand || opt.dataset.brand === brand) ? '' : 'none';
      });
    }

    document.getElementById('brand1').addEventListener('change', function() {
      filterModels(this, document.getElementById('phone1'));
      document.getElementById('phone1').value = '';
    });
    document.getElementById('brand2').addEventListener('change', function() {
      filterModels(this, document.getElementById('phone2'));
      document.getElementById('phone2').value = '';
    });

    document.getElementById('phone1').addEventListener('change', function() {
      const opt = this.selectedOptions[0];
      if (opt && opt.dataset.brand) document.getElementById('brand1').value = opt.dataset.brand;
    });
    document.getElementById('phone2').addEventListener('change', function() {
      const opt = this.selectedOptions[0];
      if (opt && opt.dataset.brand) document.getElementById('brand2').value = opt.dataset.brand;
    });

    // Search
    const searchInput = document.getElementById('phoneSearch');
    const phoneCount = document.getElementById('phoneCount');
    
    function updateVisibleCount() {
      const visible = document.querySelectorAll('.phone-card:not([style*="display: none"])').length;
      phoneCount.textContent = `${visible} phones`;
    }

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      document.querySelectorAll('.phone-card').forEach(card => {
        const name = card.dataset.name || '';
        const brand = (card.dataset.brand || '').toLowerCase();
        card.style.display = (!query || name.includes(query) || brand.includes(query)) ? '' : 'none';
      });
      document.querySelectorAll('.brand-tab').forEach(t => t.classList.remove('active'));
      if (!query) document.querySelector('.brand-tab[data-brand="all"]')?.classList.add('active');
      updateVisibleCount();
    });

    // Brand tabs
    document.querySelectorAll('.brand-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        searchInput.value = '';
        document.querySelectorAll('.brand-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const brand = tab.dataset.brand;
        document.querySelectorAll('.phone-card').forEach(card => {
          card.style.display = (brand === 'all' || card.dataset.brand === brand) ? '' : 'none';
        });
        updateVisibleCount();
      });
    });

    // Comparison
    function formatINR(num) { return '\u20B9' + num.toLocaleString('en-IN'); }

    const specs = [
      { key: 'price', label: 'Price', format: v => formatINR(v), compare: 'lower' },
      { key: 'amazonPrice', label: 'Amazon Price', format: v => v ? formatINR(v) : '\u2014' },
      { key: 'flipkartPrice', label: 'Flipkart Price', format: v => v ? formatINR(v) : '\u2014' },
      { key: 'display', label: 'Display', format: v => v },
      { key: 'displaySize', label: 'Screen Size', format: v => v },
      { key: 'processor', label: 'Processor', format: v => v },
      { key: 'ram', label: 'RAM', format: v => v },
      { key: 'storage', label: 'Storage', format: v => v },
      { key: 'mainCamera', label: 'Main Camera', format: v => v },
      { key: 'selfieCamera', label: 'Selfie Camera', format: v => v },
      { key: 'battery', label: 'Battery', format: v => v, compare: 'higher' },
      { key: 'charging', label: 'Charging', format: v => v },
      { key: 'os', label: 'OS', format: v => v },
      { key: 'has5G', label: '5G', format: v => v ? '\u2713 Yes' : '\u2717 No' },
      { key: 'weight', label: 'Weight', format: v => v || '\u2014' },
    ];

    document.getElementById('compareBtn').addEventListener('click', () => {
      const p1 = phones.find(p => p.id === document.getElementById('phone1').value);
      const p2 = phones.find(p => p.id === document.getElementById('phone2').value);
      if (!p1 || !p2) { alert('Please select both phones'); return; }

      const container = document.getElementById('comparison');
      container.classList.remove('hidden');

      let html = `
        <div class="grid grid-cols-3 border-b border-white/5 bg-white/[0.02]">
          <div class="p-4 font-semibold text-gray-500 text-xs uppercase tracking-wider flex items-center">Spec</div>
          <div class="p-5 text-center border-l border-white/5">
            ${p1.image ? `<img src="${p1.image}" alt="${p1.name}" class="w-20 h-20 object-contain mx-auto mb-2" />` : ''}
            <div class="font-extrabold text-indigo-400 text-lg">${p1.name}</div>
            <div class="text-sm text-gray-500 mt-1">${formatINR(p1.price)}</div>
          </div>
          <div class="p-5 text-center border-l border-white/5">
            ${p2.image ? `<img src="${p2.image}" alt="${p2.name}" class="w-20 h-20 object-contain mx-auto mb-2" />` : ''}
            <div class="font-extrabold text-emerald-400 text-lg">${p2.name}</div>
            <div class="text-sm text-gray-500 mt-1">${formatINR(p2.price)}</div>
          </div>
        </div>
      `;

      specs.forEach((spec, i) => {
        const v1 = p1[spec.key];
        const v2 = p2[spec.key];
        let c1 = 'text-gray-300', c2 = 'text-gray-300';
        if (spec.compare && typeof v1 === 'number' && typeof v2 === 'number') {
          if (spec.compare === 'lower') {
            if (v1 < v2) c1 = 'text-emerald-400 font-bold';
            else if (v2 < v1) c2 = 'text-emerald-400 font-bold';
          } else {
            if (v1 > v2) c1 = 'text-emerald-400 font-bold';
            else if (v2 > v1) c2 = 'text-emerald-400 font-bold';
          }
        }
        const bg = i % 2 === 0 ? 'bg-white/[0.02]' : '';
        html += `
          <div class="grid grid-cols-3 border-b border-white/5 ${bg} hover:bg-white/[0.04] transition-colors">
            <div class="p-4 text-sm font-semibold text-gray-500">${spec.label}</div>
