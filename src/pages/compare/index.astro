            <div class="p-4 text-sm text-center border-l border-white/5 ${c2}">${spec.format(v2)}</div>
          </div>
        `;
      });

      html += `
        <div class="grid grid-cols-3 bg-white/[0.03] p-4">
          <div class="text-sm font-semibold text-gray-500 flex items-center">Buy</div>
          <div class="text-center border-l border-white/5">
