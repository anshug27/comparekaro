---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us" description="Get in touch with CompareKaro.in. Send us feedback, report issues, or suggest new tools.">
  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Contact Us</h1>
    <p class="text-gray-500 mb-8">Have feedback, found an error, or want to suggest a new tool? We'd love to hear from you.</p>

    <div class="bg-white rounded-xl border border-gray-200 p-6 md:p-8">
      <form id="contact-form" class="space-y-6">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
          <input type="text" id="name" required
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" id="email" required
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
        </div>
        <div>
          <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
          <select id="subject" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option>General Feedback</option>
            <option>Bug Report</option>
            <option>Suggest a Tool</option>
            <option>Data Correction</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
          <textarea id="message" rows="5" required
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
        </div>
        <button type="submit"
          class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">
          Send Message
        </button>
      </form>
      <div id="form-success" class="hidden text-center py-8">
        <div class="text-4xl mb-4">&#10003;</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Message Sent!</h3>
        <p class="text-gray-500">Thank you for reaching out. We'll get back to you soon.</p>
      </div>
    </div>
  </section>

  <script>
    document.getElementById('contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      // In production, this would send to a Cloudflare Worker endpoint
      document.getElementById('contact-form')!.classList.add('hidden');
      document.getElementById('form-success')!.classList.remove('hidden');
    });
  </script>
</Layout>
